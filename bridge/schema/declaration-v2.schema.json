{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ahepi.github.io/h-EPI/schema/cr-eib.bridge-declaration.v2.json",
  "title": "CR-EIB bridge declaration v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "declaration_id",
    "authoritative_id",
    "source_anchor_digest",
    "mapping_status",
    "source_inferential_status",
    "proposed_inferential_status",
    "parameters",
    "binder_semantics",
    "opaque_ports",
    "dependencies",
    "claim_scope",
    "interpretation",
    "typed_body",
    "proof_obligations",
    "evidence_policy",
    "replay"
  ],
  "properties": {
    "schema_version": {"const": "cr-eib.bridge-declaration.v2"},
    "declaration_id": {"$ref": "#/$defs/declarationId"},
    "authoritative_id": {"$ref": "#/$defs/declarationId"},
    "source_anchor_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "mapping_status": {"enum": ["candidate", "accepted", "rejected", "blocked"]},
    "source_inferential_status": {"type": "null"},
    "proposed_inferential_status": {"enum": [null, "DEF", "IMP", "DER"]},
    "parameters": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "sort", "binding"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "sort": {"type": "string", "minLength": 1},
          "binding": {"const": "explicit"}
        }
      }
    },
    "binder_semantics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["order_significant", "dependency_mode", "order", "hidden_arguments"],
      "properties": {
        "order_significant": {"const": true},
        "dependency_mode": {"const": "left-to-right-dependent"},
        "order": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "hidden_arguments": {"type": "array", "maxItems": 0}
      }
    },
    "opaque_ports": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "signature", "binding"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "signature": {"type": "string", "minLength": 1},
          "binding": {"enum": ["model-field", "bridge-structure-field"]}
        }
      }
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_declared", "reconstructed_source", "bridge"],
      "properties": {
        "source_declared": {"$ref": "#/$defs/idArray"},
        "reconstructed_source": {"$ref": "#/$defs/idArray"},
        "bridge": {"$ref": "#/$defs/idArray"}
      }
    },
    "claim_scope": {"type": "string", "minLength": 1},
    "interpretation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "class",
        "choice_ids",
        "authority_status",
        "bridge_status",
        "review_status",
        "preserves",
        "loses",
        "coverage"
      ],
      "properties": {
        "class": {"enum": ["explicitation", "abbreviation", "refinement", "assumption"]},
        "choice_ids": {"$ref": "#/$defs/idArray"},
        "authority_status": {"const": "non-authoritative-interpretation"},
        "bridge_status": {"enum": ["proposed", "accepted", "rejected", "blocked"]},
        "review_status": {"enum": ["unreviewed", "in-review", "accepted", "rejected"]},
        "preserves": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/preservation"}
        },
        "loses": {
          "type": "array",
          "items": {"$ref": "#/$defs/loss"}
        },
        "coverage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["coverage_id", "status", "scope", "excluded"],
          "properties": {
            "coverage_id": {"$ref": "#/$defs/declarationId"},
            "status": {"enum": ["partial", "exact"]},
            "scope": {"type": "string", "minLength": 1},
            "excluded": {
              "type": "array",
              "items": {"$ref": "#/$defs/exclusion"}
            }
          }
        }
      }
    },
    "typed_body": {
      "type": "object",
      "additionalProperties": false,
      "required": ["language", "symbol", "path", "sha256", "closed_proposition"],
      "properties": {
        "language": {"const": "Lean4"},
        "symbol": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "closed_proposition": {"type": "boolean"}
      }
    },
    "proof_obligations": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/proofObligation"}
    },
    "evidence_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["missing_is_false", "explicit_negative_required_for_countermodel"],
      "properties": {
        "missing_is_false": {"const": false},
        "explicit_negative_required_for_countermodel": {"type": "boolean"}
      }
    },
    "replay": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "tool", "toolchain", "command", "expected_axioms"],
      "properties": {
        "status": {"enum": ["pending-ci", "verified"]},
        "tool": {"const": "Lean4"},
        "toolchain": {"const": "leanprover/lean4:v4.33.1"},
        "command": {"type": "string", "minLength": 1},
        "expected_axioms": {"type": "array", "items": {"type": "string"}}
      }
    }
  },
  "$defs": {
    "declarationId": {"type": "string", "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Za-z0-9]+)+$"},
    "idArray": {
      "type": "array",
      "items": {"$ref": "#/$defs/declarationId"},
      "uniqueItems": true
    },
    "preservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preservation_id", "statement"],
      "properties": {
        "preservation_id": {"$ref": "#/$defs/declarationId"},
        "statement": {"type": "string", "minLength": 1}
      }
    },
    "loss": {
      "type": "object",
      "additionalProperties": false,
      "required": ["loss_id", "statement"],
      "properties": {
        "loss_id": {"$ref": "#/$defs/declarationId"},
        "statement": {"type": "string", "minLength": 1}
      }
    },
    "exclusion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exclusion_id", "statement"],
      "properties": {
        "exclusion_id": {"$ref": "#/$defs/declarationId"},
        "statement": {"type": "string", "minLength": 1}
      }
    },
    "proofArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["language", "symbol", "path", "sha256", "replay_status"],
      "properties": {
        "language": {"const": "Lean4"},
        "symbol": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "replay_status": {"const": "verified"}
      }
    },
    "proofObligation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["obligation_id", "kind", "statement", "status", "artifact"],
      "properties": {
        "obligation_id": {"$ref": "#/$defs/declarationId"},
        "kind": {"enum": ["fold-unfold", "source-projection", "model-expansion"]},
        "statement": {"type": "string", "minLength": 1},
        "status": {"enum": ["open", "verified", "blocked"]},
        "artifact": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/proofArtifact"}]}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "verified"}}, "required": ["status"]},
          "then": {"properties": {"artifact": {"$ref": "#/$defs/proofArtifact"}}},
          "else": {"properties": {"artifact": {"type": "null"}}}
        }
      ]
    }
  }
}
