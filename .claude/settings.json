{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease*)",
      "Bash(git push origin HEAD:main*)",
      "Bash(git push origin HEAD:refs/heads/main*)",
      "Bash(git push * HEAD:main*)",
      "Bash(git push * main)",
      "Bash(git reset --hard*)",
      "Bash(git clean *)",
      "Bash(git add -A)",
      "Bash(git add -A *)",
      "Bash(git add --all*)",
      "Bash(git add .)",
      "Bash(git add . *)",
      "Bash(git tag -d *)",
      "Bash(git branch -D *)",
      "Bash(git rebase *)",
      "Bash(git commit --amend*)",
      "Bash(git checkout main)",
      "Bash(git switch main)"
    ]
  }
}
