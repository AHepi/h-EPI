{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ahepi.example/smf/0.4/translation-source-span.schema.json",
  "title": "Semantic Forge translation source span v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "span_id",
    "supersedes_span_id",
    "document_id",
    "span_key",
    "segments",
    "context_span_ids",
    "legacy_refs",
    "source_inferential_status",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "const": "creib.semantic-forge.translation-source-span.v1"
    },
    "span_id": {"$ref": "#/$defs/spanId"},
    "supersedes_span_id": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/spanId"}
      ]
    },
    "document_id": {"$ref": "#/$defs/documentId"},
    "span_key": {"$ref": "#/$defs/stableKey"},
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/segment"},
      "uniqueItems": true
    },
    "context_span_ids": {
      "type": "array",
      "items": {"$ref": "#/$defs/spanId"},
      "uniqueItems": true
    },
    "legacy_refs": {
      "type": "array",
      "items": {"$ref": "#/$defs/legacyRef"},
      "uniqueItems": true
    },
    "source_inferential_status": {"type": "null"},
    "provenance": {"$ref": "#/$defs/provenance"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "contentId": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]*:[0-9a-f]{64}$"
    },
    "documentId": {"type": "string", "pattern": "^TDOC:[0-9a-f]{64}$"},
    "spanId": {"type": "string", "pattern": "^TSPAN:[0-9a-f]{64}$"},
    "stableKey": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
    },
    "nonemptyString": {"type": "string", "minLength": 1},
    "bbox": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "prefixItems": [
        {"type": "integer", "minimum": 0},
        {"type": "integer", "minimum": 0},
        {"type": "integer", "minimum": 1},
        {"type": "integer", "minimum": 1}
      ],
      "items": false
    },
    "pdfLocator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "physical_page",
        "page_index_zero_based",
        "printed_label",
        "section_raw",
        "page_size_millipoints",
        "page_rotation_degrees",
        "bbox_millipoints"
      ],
      "properties": {
        "kind": {"const": "PDF_REGION"},
        "physical_page": {"type": "integer", "minimum": 1},
        "page_index_zero_based": {"type": "integer", "minimum": 0},
        "printed_label": {"type": ["string", "null"]},
        "section_raw": {"type": ["string", "null"]},
        "page_size_millipoints": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "prefixItems": [
            {"type": "integer", "minimum": 1},
            {"type": "integer", "minimum": 1}
          ],
          "items": false
        },
        "page_rotation_degrees": {"enum": [0, 90, 180, 270]},
        "bbox_millipoints": {"$ref": "#/$defs/bbox"}
      }
    },
    "textLocator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "start_byte", "end_byte_exclusive", "encoding"],
      "properties": {
        "kind": {"const": "UTF8_BYTE_RANGE"},
        "start_byte": {"type": "integer", "minimum": 0},
        "end_byte_exclusive": {"type": "integer", "minimum": 1},
        "encoding": {"const": "UTF-8"}
      }
    },
    "literalSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "tool",
        "tool_version",
        "selection_rule",
        "item_count",
        "digest_domain",
        "sha256"
      ],
      "properties": {
        "algorithm": {"$ref": "#/$defs/nonemptyString"},
        "tool": {"$ref": "#/$defs/nonemptyString"},
        "tool_version": {"$ref": "#/$defs/nonemptyString"},
        "selection_rule": {"$ref": "#/$defs/nonemptyString"},
        "item_count": {"type": "integer", "minimum": 1},
        "digest_domain": {"$ref": "#/$defs/nonemptyString"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "reviewedTranscription": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "encoding",
        "unicode_normalization",
        "eol",
        "final_newline",
        "declared_transformations"
      ],
      "properties": {
        "path": {"$ref": "#/$defs/nonemptyString"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "encoding": {"const": "UTF-8"},
        "unicode_normalization": {"const": "NFC"},
        "eol": {"const": "LF"},
        "final_newline": {"type": "boolean"},
        "declared_transformations": {
          "type": "array",
          "items": {"$ref": "#/$defs/nonemptyString"},
          "uniqueItems": true
        }
      }
    },
    "segment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ordinal", "locator", "literal_snapshot", "reviewed_transcription"],
      "properties": {
        "ordinal": {"type": "integer", "minimum": 1},
        "locator": {
          "oneOf": [
            {"$ref": "#/$defs/pdfLocator"},
            {"$ref": "#/$defs/textLocator"}
          ]
        },
        "literal_snapshot": {"$ref": "#/$defs/literalSnapshot"},
        "reviewed_transcription": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/reviewedTranscription"}
          ]
        }
      }
    },
    "legacyRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["namespace", "record_id"],
      "properties": {
        "namespace": {"$ref": "#/$defs/nonemptyString"},
        "record_id": {"$ref": "#/$defs/nonemptyString"}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["producer_kind", "producer_id", "created_at", "generation_record_ids"],
      "properties": {
        "producer_kind": {"enum": ["HUMAN", "TOOL", "LLM"]},
        "producer_id": {"$ref": "#/$defs/nonemptyString"},
        "created_at": {"type": "string", "format": "date-time"},
        "generation_record_ids": {
          "type": "array",
          "items": {"$ref": "#/$defs/contentId"},
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"producer_kind": {"const": "LLM"}},
            "required": ["producer_kind"]
          },
          "then": {
            "properties": {"generation_record_ids": {"minItems": 1}}
          }
        }
      ]
    }
  }
}
