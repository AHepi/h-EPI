{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ahepi.example/smf/0.4/translation-charter.schema.json",
  "title": "Semantic Forge translation charter v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "charter_id",
    "supersedes_charter_id",
    "title",
    "problem_statement",
    "purpose",
    "output_kind",
    "authority_bindings",
    "in_scope",
    "out_of_scope",
    "system_boundary",
    "protected_distinctions",
    "success_claim",
    "policies",
    "proposal_status",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "const": "creib.semantic-forge.translation-charter.v1"
    },
    "charter_id": {"$ref": "#/$defs/charterId"},
    "supersedes_charter_id": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/charterId"}
      ]
    },
    "title": {"$ref": "#/$defs/nonemptyString"},
    "problem_statement": {"$ref": "#/$defs/nonemptyString"},
    "purpose": {"$ref": "#/$defs/nonemptyString"},
    "output_kind": {"const": "NEUTRAL_SEMANTIC_MODEL"},
    "authority_bindings": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/authorityBinding"},
      "uniqueItems": true
    },
    "in_scope": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/nonemptyString"},
      "uniqueItems": true
    },
    "out_of_scope": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/nonemptyString"},
      "uniqueItems": true
    },
    "system_boundary": {"$ref": "#/$defs/nonemptyString"},
    "protected_distinctions": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/protectedDistinction"},
      "uniqueItems": true
    },
    "success_claim": {"const": "SCOPED_FIT_ONLY"},
    "policies": {"$ref": "#/$defs/policies"},
    "proposal_status": {"const": "PROPOSED"},
    "provenance": {"$ref": "#/$defs/provenance"}
  },
  "oneOf": [
    {
      "properties": {
        "authority_bindings": {
          "contains": {
            "properties": {"role": {"const": "SOLE_SEMANTIC_AUTHORITY"}},
            "required": ["role"]
          },
          "minContains": 1,
          "maxContains": 1,
          "not": {
            "contains": {
              "properties": {"role": {"const": "CO_SEMANTIC_AUTHORITY"}},
              "required": ["role"]
            }
          }
        }
      }
    },
    {
      "properties": {
        "authority_bindings": {
          "contains": {
            "properties": {"role": {"const": "CO_SEMANTIC_AUTHORITY"}},
            "required": ["role"]
          },
          "minContains": 1,
          "not": {
            "contains": {
              "properties": {"role": {"const": "SOLE_SEMANTIC_AUTHORITY"}},
              "required": ["role"]
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "contentId": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]*:[0-9a-f]{64}$"
    },
    "documentId": {"type": "string", "pattern": "^TDOC:[0-9a-f]{64}$"},
    "charterId": {"type": "string", "pattern": "^TCHAR:[0-9a-f]{64}$"},
    "distinctionId": {"type": "string", "pattern": "^TPD:[0-9a-f]{64}$"},
    "nonemptyString": {"type": "string", "minLength": 1},
    "authorityBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document_id", "role"],
      "properties": {
        "document_id": {"$ref": "#/$defs/documentId"},
        "role": {
          "enum": [
            "SOLE_SEMANTIC_AUTHORITY",
            "CO_SEMANTIC_AUTHORITY",
            "CONTEXT_ONLY",
            "ADVISORY"
          ]
        }
      }
    },
    "protectedDistinction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["distinction_id", "statement"],
      "properties": {
        "distinction_id": {"$ref": "#/$defs/distinctionId"},
        "statement": {"$ref": "#/$defs/nonemptyString"}
      }
    },
    "policies": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "formalism_can_override_valid_prose",
        "test_survival_effect",
        "research_role",
        "ambiguity_policy",
        "missing_mapping_policy",
        "conflict_policy",
        "human_semantic_decision_required"
      ],
      "properties": {
        "formalism_can_override_valid_prose": {"const": false},
        "test_survival_effect": {"const": "UNREFUTED_ONLY"},
        "research_role": {"const": "CRITICISM_DISCOVERY_ONLY"},
        "ambiguity_policy": {"const": "PRESERVE_RIVALS"},
        "missing_mapping_policy": {"const": "OPEN_LOSS"},
        "conflict_policy": {"const": "PRESERVE_CONFLICT_FOR_REVIEW"},
        "human_semantic_decision_required": {"const": true}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["producer_kind", "producer_id", "created_at", "generation_record_ids"],
      "properties": {
        "producer_kind": {"enum": ["HUMAN", "TOOL", "LLM"]},
        "producer_id": {"$ref": "#/$defs/nonemptyString"},
        "created_at": {"type": "string", "format": "date-time"},
        "generation_record_ids": {
          "type": "array",
          "items": {"$ref": "#/$defs/contentId"},
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"producer_kind": {"const": "LLM"}},
            "required": ["producer_kind"]
          },
          "then": {
            "properties": {"generation_record_ids": {"minItems": 1}}
          }
        }
      ]
    }
  }
}
