{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ahepi.example/smf/0.1/calibration-run.schema.json",
  "title": "SMF-0.1 deterministic calibration run",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "run_status",
    "mechanical_status",
    "epistemic_status",
    "review_status",
    "result_scope",
    "semantic_verdict",
    "human_disposition",
    "epistemic_limit",
    "authority_binding",
    "corpus_trace",
    "execution_contract",
    "fixture_evaluations",
    "research_routing",
    "hardening_assessments",
    "formalization_readiness",
    "human_review"
  ],
  "properties": {
    "schema_version": {
      "const": "creib.semantic-forge.calibration-run.v1"
    },
    "run_id": {
      "const": "SMF-CALIBRATION-CR-1-0-001"
    },
    "run_status": {
      "const": "RUN_COMPLETE"
    },
    "mechanical_status": {
      "const": "MECHANICALLY_VALID"
    },
    "epistemic_status": {
      "const": "UNRESOLVED"
    },
    "review_status": {
      "const": "AWAITING_HUMAN"
    },
    "result_scope": {
      "const": "NON_AUTHORITATIVE_MECHANICAL_CALIBRATION"
    },
    "semantic_verdict": {
      "type": "null"
    },
    "human_disposition": {
      "type": "null"
    },
    "epistemic_limit": {
      "const": "Survival of criticism leaves a claim unrefuted; pass counts, consensus, and confidence do not justify it."
    },
    "authority_binding": {
      "$ref": "#/$defs/authority_binding"
    },
    "corpus_trace": {
      "$ref": "#/$defs/corpus_trace"
    },
    "execution_contract": {
      "$ref": "#/$defs/execution_contract"
    },
    "fixture_evaluations": {
      "$ref": "#/$defs/fixture_evaluations"
    },
    "research_routing": {
      "$ref": "#/$defs/research_routing"
    },
    "hardening_assessments": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "naive_disconnected_revision",
        "substantive_connected_proposal"
      ],
      "properties": {
        "naive_disconnected_revision": {
          "$ref": "#/$defs/hardening_assessment"
        },
        "substantive_connected_proposal": {
          "$ref": "#/$defs/hardening_assessment"
        }
      }
    },
    "formalization_readiness": {
      "$ref": "#/$defs/formalization_readiness"
    },
    "human_review": {
      "$ref": "#/$defs/human_review"
    }
  },
  "$defs": {
    "nonempty_string": {
      "type": "string",
      "minLength": 1
    },
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "digest_map": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/identifier"
      },
      "additionalProperties": {
        "$ref": "#/$defs/sha256"
      }
    },
    "string_array": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/nonempty_string"
      }
    },
    "rival": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rival_id",
        "claim",
        "falsifier_conditions"
      ],
      "properties": {
        "rival_id": {
          "$ref": "#/$defs/identifier"
        },
        "claim": {
          "$ref": "#/$defs/nonempty_string"
        },
        "falsifier_conditions": {
          "$ref": "#/$defs/string_array"
        }
      }
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "issue_id",
        "question",
        "unknown_kind",
        "decision",
        "decision_relevance",
        "rivals",
        "expected_discriminator",
        "admissible_source_scope",
        "stop_condition"
      ],
      "properties": {
        "schema_version": {
          "const": "creib.semantic-forge.issue.v1"
        },
        "issue_id": {
          "$ref": "#/$defs/identifier"
        },
        "question": {
          "$ref": "#/$defs/nonempty_string"
        },
        "unknown_kind": {
          "enum": [
            "internal",
            "external",
            "undecided"
          ]
        },
        "decision": {
          "$ref": "#/$defs/nonempty_string"
        },
        "decision_relevance": {
          "oneOf": [
            {
              "$ref": "#/$defs/nonempty_string"
            },
            {
              "type": "null"
            }
          ]
        },
        "rivals": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/rival"
          }
        },
        "expected_discriminator": {
          "oneOf": [
            {
              "$ref": "#/$defs/nonempty_string"
            },
            {
              "type": "null"
            }
          ]
        },
        "admissible_source_scope": {
          "$ref": "#/$defs/string_array"
        },
        "stop_condition": {
          "oneOf": [
            {
              "$ref": "#/$defs/nonempty_string"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "research_warrant": {
