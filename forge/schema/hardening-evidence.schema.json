{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ahepi.example/smf/0.4/hardening-evidence.schema.json",
  "title": "Semantic Model Forge hardening evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "record_type", "evidence_id", "comparison_id",
    "comparison_sha256", "obligation_id", "evidence_kind", "checker",
    "input_refs", "payload", "payload_sha256", "outcome",
    "epistemic_effect", "semantic_verdict", "epistemic_limit"
  ],
  "properties": {
    "schema_version": {"const": "creib.semantic-forge.hardening-evidence.v1"},
    "record_type": {"const": "hardening_evidence"},
    "evidence_id": {"type": "string", "pattern": "^HE:[0-9a-f]{64}$"},
    "comparison_id": {"type": "string", "pattern": "^HC:[0-9a-f]{64}$"},
    "comparison_sha256": {"$ref": "#/$defs/digest"},
    "obligation_id": {"type": "string", "pattern": "^HO:[0-9a-f]{64}$"},
    "evidence_kind": {
      "enum": [
        "OLD_RESULT_NON_BROADENING", "ROLE_FIBER_NON_BROADENING",
        "TARGETED_GAIN_OLD_RESULT", "TARGETED_GAIN_ROLE_FIBER",
        "SUCCESSOR_NON_VACUITY", "POSITIVE_PRESERVATION",
        "EXCLUSION_PRESERVATION", "CONSEQUENCE_PRESERVATION",
        "SCOPE_PRESERVATION", "CLAUSE_INDEPENDENCE",
        "TYPE_DEPENDENCY_PRESERVATION"
      ]
    },
    "checker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checker_id", "checker_version", "implementation_sha256"],
      "properties": {
        "checker_id": {"const": "SMF-HARDENING-DECLARATION-PARSER-V1"},
        "checker_version": {"const": "1"},
        "implementation_sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "input_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/record_ref"}},
    "payload": {"oneOf": [
      {"$ref": "#/$defs/old_result_sets"},
      {"$ref": "#/$defs/role_fibers"},
      {"$ref": "#/$defs/successor_models"},
      {"$ref": "#/$defs/positive_pair"},
      {"$ref": "#/$defs/exclusion_pair"},
      {"$ref": "#/$defs/consequence_pair"},
      {"$ref": "#/$defs/scope_pairs"},
      {"$ref": "#/$defs/clause_deletion"},
      {"$ref": "#/$defs/type_dependency_checks"}
    ]},
    "payload_sha256": {"$ref": "#/$defs/digest"},
    "outcome": {"const": "INCONCLUSIVE"},
    "epistemic_effect": {"const": "DECLARED_PAYLOAD_ONLY"},
    "semantic_verdict": {"type": "null"},
    "epistemic_limit": {"const": "Survival of criticism leaves a claim unrefuted; pass counts, consensus, and confidence do not justify it."}
  },
  "$defs": {
    "nonempty": {"type": "string", "minLength": 1},
    "identifier": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,255}$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "identifier_array": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
    "record_ref": {
      "type": "object", "additionalProperties": false,
      "required": ["record_id", "schema_version", "record_sha256"],
      "properties": {
        "record_id": {"$ref": "#/$defs/identifier"},
        "schema_version": {"$ref": "#/$defs/identifier"},
        "record_sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "fiber_array": {
      "type": "array", "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["control_id", "assignments"],
        "properties": {
          "control_id": {"$ref": "#/$defs/identifier"},
          "assignments": {"$ref": "#/$defs/identifier_array"}
        }
      }
    },
    "old_result_sets": {
      "type": "object", "additionalProperties": false,
      "required": ["payload_type", "coverage", "baseline_values", "successor_values"],
      "properties": {
        "payload_type": {"const": "OLD_RESULT_SETS"},
        "coverage": {"enum": ["FINITE_EXHAUSTIVE", "NONEXHAUSTIVE_SEARCH"]},
        "baseline_values": {"$ref": "#/$defs/identifier_array"},
        "successor_values": {"$ref": "#/$defs/identifier_array"}
      }
    },
    "role_fibers": {
      "type": "object", "additionalProperties": false,
      "required": ["payload_type", "coverage", "baseline_fibers", "successor_fibers"],
      "properties": {
        "payload_type": {"const": "ROLE_FIBERS"},
        "coverage": {"enum": ["FINITE_EXHAUSTIVE", "NONEXHAUSTIVE_SEARCH"]},
        "baseline_fibers": {"$ref": "#/$defs/fiber_array"},
        "successor_fibers": {"$ref": "#/$defs/fiber_array"}
      }
    },
    "successor_models": {
      "type": "object", "additionalProperties": false,
      "required": ["payload_type", "successor_model_ids", "retained_positive_ids"],
      "properties": {
        "payload_type": {"const": "SUCCESSOR_MODELS"},
        "successor_model_ids": {"$ref": "#/$defs/identifier_array"},
        "retained_positive_ids": {"$ref": "#/$defs/identifier_array"}
      }
    },
    "positive_pair": {
      "type": "object", "additionalProperties": false,
      "required": ["payload_type", "protection_id", "baseline_model_id", "successor_model_id", "baseline_scope_sha256", "successor_scope_sha256", "baseline_classification_sha256", "successor_classification_sha256"],
      "properties": {
        "payload_type": {"const": "POSITIVE_PAIR"},
        "protection_id": {"$ref": "#/$defs/identifier"},
        "baseline_model_id": {"$ref": "#/$defs/identifier"},
        "successor_model_id": {"$ref": "#/$defs/identifier"},
        "baseline_scope_sha256": {"$ref": "#/$defs/digest"},
        "successor_scope_sha256": {"$ref": "#/$defs/digest"},
        "baseline_classification_sha256": {"$ref": "#/$defs/digest"},
        "successor_classification_sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "exclusion_pair": {
      "type": "object", "additionalProperties": false,
      "required": ["payload_type", "protection_id", "baseline_context_live", "successor_context_live", "baseline_excluded", "successor_excluded", "baseline_scope_sha256", "successor_scope_sha256"],
      "properties": {
        "payload_type": {"const": "EXCLUSION_PAIR"},
        "protection_id": {"$ref": "#/$defs/identifier"},
        "baseline_context_live": {"type": "boolean"},
        "successor_context_live": {"type": "boolean"},
        "baseline_excluded": {"type": "boolean"},
        "successor_excluded": {"type": "boolean"},
        "baseline_scope_sha256": {"$ref": "#/$defs/digest"},
        "successor_scope_sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "consequence_pair": {
      "type": "object", "additionalProperties": false,
      "required": ["payload_type", "protection_id", "baseline_entailed", "successor_entailed", "baseline_closure_sha256", "successor_closure_sha256", "formula_sha256"],
      "properties": {
        "payload_type": {"const": "CONSEQUENCE_PAIR"},
        "protection_id": {"$ref": "#/$defs/identifier"},
        "baseline_entailed": {"type": "boolean"},
        "successor_entailed": {"type": "boolean"},
        "baseline_closure_sha256": {"$ref": "#/$defs/digest"},
        "successor_closure_sha256": {"$ref": "#/$defs/digest"},
        "formula_sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "scope_pairs": {
      "type": "object", "additionalProperties": false,
      "required": ["payload_type", "scope_pairs"],
      "properties": {
        "payload_type": {"const": "SCOPE_PAIRS"},
        "scope_pairs": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["subject_id", "baseline_sha256", "successor_sha256"],
            "properties": {
              "subject_id": {"$ref": "#/$defs/identifier"},
              "baseline_sha256": {"$ref": "#/$defs/digest"},
              "successor_sha256": {"$ref": "#/$defs/digest"}
            }
          }
        }
      }
    },
    "clause_deletion": {
      "type": "object", "additionalProperties": false,
      "required": ["payload_type", "clause_id", "defect_witness_id", "full_successor_excludes_defect", "deleted_clause_readmits_defect", "full_scope_sha256", "deleted_scope_sha256"],
      "properties": {
        "payload_type": {"const": "CLAUSE_DELETION"},
        "clause_id": {"$ref": "#/$defs/identifier"},
        "defect_witness_id": {"$ref": "#/$defs/identifier"},
        "full_successor_excludes_defect": {"type": "boolean"},
        "deleted_clause_readmits_defect": {"type": "boolean"},
        "full_scope_sha256": {"$ref": "#/$defs/digest"},
        "deleted_scope_sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "type_dependency_checks": {
      "type": "object", "additionalProperties": false,
      "required": ["payload_type", "delta_complete", "types_preserved", "dependencies_closed", "transports_explicit"],
      "properties": {
        "payload_type": {"const": "TYPE_DEPENDENCY_CHECKS"},
        "delta_complete": {"type": "boolean"},
        "types_preserved": {"type": "boolean"},
        "dependencies_closed": {"type": "boolean"},
        "transports_explicit": {"type": "boolean"}
      }
    }
  }
}
