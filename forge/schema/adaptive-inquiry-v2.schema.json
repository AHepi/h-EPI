{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ahepi.example/smf/0.3/adaptive-inquiry-v2.schema.json",
  "title": "SMF adaptive inquiry records v2",
  "oneOf": [
    {
      "$ref": "#/$defs/human_failure_triage"
    },
    {
      "$ref": "#/$defs/inquiry_plan"
    }
  ],
  "$defs": {
    "nonempty_string": {
      "$ref": "https://ahepi.example/smf/0.2/adaptive-inquiry.schema.json#/$defs/nonempty_string"
    },
    "identifier": {
      "$ref": "https://ahepi.example/smf/0.2/adaptive-inquiry.schema.json#/$defs/identifier"
    },
    "domain_sha256": {
      "$ref": "https://ahepi.example/smf/0.2/adaptive-inquiry.schema.json#/$defs/domain_sha256"
    },
    "date": {
      "$ref": "https://ahepi.example/smf/0.2/adaptive-inquiry.schema.json#/$defs/date"
    },
    "research_ledger_binding": {
      "$ref": "https://ahepi.example/smf/0.2/adaptive-inquiry.schema.json#/$defs/research_ledger_binding"
    },
    "bindings": {
      "$ref": "https://ahepi.example/smf/0.2/adaptive-inquiry.schema.json#/$defs/bindings"
    },
    "search_protocol": {
      "$ref": "https://ahepi.example/smf/0.2/adaptive-inquiry.schema.json#/$defs/search_protocol"
    },
    "uncertainty_location": {
      "type": "string",
      "enum": [
        "INTERNAL_DEDUCTION_OR_MODEL_FINDING",
        "INTERNAL_HARNESS_SPECIFICATION",
        "CR_AUTHORITY_INTERPRETATION",
        "EXTERNAL_CRITICAL_INSTRUMENT",
        "APPLICATION_EMPIRICAL",
        "UNLOCATED"
      ]
    },
    "locus_assessment_id": {
      "type": "string",
      "pattern": "^LA:[0-9a-f]{64}$"
    },
    "assessment_disposition_id": {
      "type": "string",
      "pattern": "^AD:[0-9a-f]{64}$"
    },
    "evidence_binding_id": {
      "type": "string",
      "pattern": "^EB:[0-9a-f]{64}$"
    },
    "triage_id": {
      "type": "string",
      "pattern": "^HT:[0-9a-f]{64}$"
    },
    "attack_target_id": {
      "type": "string",
      "pattern": "^AT:[0-9a-f]{64}$"
    },
    "locus_assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assessment_id",
        "status",
        "loci",
        "mechanism",
        "relevance",
        "discriminator",
        "scope",
        "uncertainty_location",
        "depends_on_assessment_ids",
        "epistemic_effect",
        "can_establish_unique_cause"
      ],
      "properties": {
        "assessment_id": {
          "$ref": "#/$defs/locus_assessment_id"
        },
        "status": {
          "const": "LIVE"
        },
        "loci": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "CANDIDATE",
              "AUXILIARY",
              "TEST",
              "SCOPE"
            ]
          }
        },
        "mechanism": {
          "$ref": "#/$defs/nonempty_string"
        },
        "relevance": {
          "$ref": "#/$defs/nonempty_string"
        },
        "discriminator": {
          "$ref": "#/$defs/nonempty_string"
        },
        "scope": {
          "$ref": "#/$defs/nonempty_string"
        },
        "uncertainty_location": {
          "$ref": "#/$defs/uncertainty_location"
        },
        "depends_on_assessment_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/locus_assessment_id"
          }
        },
        "epistemic_effect": {
          "const": "CRITICISM_ONLY"
        },
        "can_establish_unique_cause": {
          "const": false
        }
      }
    },
    "disposition_evidence_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_binding_id",
        "evidence_kind",
        "record_id",
        "record_id_pointer",
        "record_snapshot",
        "record_sha256",
        "selected_value_pointer",
        "selected_value_sha256",
        "bearing"
      ],
      "properties": {
        "evidence_binding_id": {
          "$ref": "#/$defs/evidence_binding_id"
        },
        "evidence_kind": {
          "type": "string",
          "enum": [
            "CALIBRATION_RUN",
            "INPUT_BINDING_DELTA"
          ]
        },
        "record_id": {
          "$ref": "#/$defs/nonempty_string"
        },
        "record_id_pointer": {
          "type": "string",
          "pattern": "^(?:|/(?:[^~/]|~[01])*(?:/(?:[^~/]|~[01])*)*)$"
        },
        "record_snapshot": {
          "type": "object"
        },
        "record_sha256": {
          "$ref": "#/$defs/domain_sha256"
        },
        "selected_value_pointer": {
          "type": "string",
          "pattern": "^(?:|/(?:[^~/]|~[01])*(?:/(?:[^~/]|~[01])*)*)$"
        },
        "selected_value_sha256": {
          "$ref": "#/$defs/domain_sha256"
        },
        "bearing": {
          "$ref": "#/$defs/nonempty_string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "evidence_kind": {
                "const": "CALIBRATION_RUN"
              }
            },
            "required": [
              "evidence_kind"
            ]
          },
          "then": {
            "properties": {
              "record_id_pointer": {
                "const": "/run_id"
              },
              "selected_value_pointer": {
                "const": "/fixture_evaluations/weak_typed_role_projection"
              }
            }
          },
          "else": {
            "properties": {
              "record_id": {
                "const": "TRIAGE-BINDING-DELTA"
              },
              "record_id_pointer": {
                "const": "/record_id"
              }
            }
          }
        }
      ]
    },
    "assessment_disposition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "record_type",
        "disposition_id",
        "assessment_id",
        "assessment_origin_triage_id",
        "decision_sequence",
        "previous_disposition_id",
        "created_on",
        "bindings",
        "disposition",
        "declared_discriminator",
        "evidence_bindings",
        "reason",
        "superseded_bindings",
        "changed_binding_pointers",
        "reviewer_kind",
        "machine_generated",
        "epistemic_effect",
        "can_establish_unique_cause",
        "can_promote_model",
        "can_confirm_target_semantics",
        "not_found_can_dispose",
        "source_count_can_decide",
        "provider_agreement_can_decide",
        "semantic_verdict"
      ],
      "properties": {
        "schema_version": {
          "const": "creib.semantic-forge.assessment-disposition.v1"
        },
        "record_type": {
          "const": "assessment_disposition"
        },
        "disposition_id": {
          "$ref": "#/$defs/assessment_disposition_id"
        },
        "assessment_id": {
          "$ref": "#/$defs/locus_assessment_id"
        },
        "assessment_origin_triage_id": {
          "$ref": "#/$defs/triage_id"
        },
        "decision_sequence": {
          "type": "integer",
          "minimum": 1
        },
        "previous_disposition_id": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/assessment_disposition_id"
            }
          ]
        },
        "created_on": {
          "$ref": "#/$defs/date"
        },
        "bindings": {
          "$ref": "#/$defs/bindings"
        },
        "disposition": {
          "type": "string",
          "enum": [
            "RETAINED",
            "DEFEATED",
            "STALE_BY_BINDING_CHANGE"
          ]
        },
        "declared_discriminator": {
          "$ref": "#/$defs/nonempty_string"
        },
        "evidence_bindings": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/disposition_evidence_binding"
          }
        },
        "reason": {
          "$ref": "#/$defs/nonempty_string"
        },
        "superseded_bindings": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/bindings"
            }
          ]
        },
        "changed_binding_pointers": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^/"
          }
        },
        "reviewer_kind": {
          "const": "HUMAN"
        },
        "machine_generated": {
          "const": false
        },
        "epistemic_effect": {
          "const": "ASSESSMENT_WORKFLOW_ONLY"
        },
        "can_establish_unique_cause": {
          "const": false
        },
        "can_promote_model": {
          "const": false
        },
        "can_confirm_target_semantics": {
          "const": false
        },
        "not_found_can_dispose": {
          "const": false
        },
        "source_count_can_decide": {
          "const": false
        },
        "provider_agreement_can_decide": {
          "const": false
        },
        "semantic_verdict": {
          "type": "null"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "disposition": {
                "const": "STALE_BY_BINDING_CHANGE"
              }
            },
            "required": [
              "disposition"
            ]
          },
          "then": {
            "properties": {
              "superseded_bindings": {
                "$ref": "#/$defs/bindings"
              },
              "changed_binding_pointers": {
                "minItems": 1
              },
              "evidence_bindings": {
                "contains": {
                  "properties": {
                    "evidence_kind": {
                      "const": "INPUT_BINDING_DELTA"
                    }
                  },
                  "required": [
                    "evidence_kind"
                  ]
                }
              }
            }
          },
          "else": {
            "properties": {
              "superseded_bindings": {
                "type": "null"
              },
              "changed_binding_pointers": {
                "maxItems": 0
              },
              "evidence_bindings": {
                "contains": {
                  "properties": {
                    "evidence_kind": {
                      "const": "CALIBRATION_RUN"
                    }
                  },
                  "required": [
                    "evidence_kind"
                  ]
                },
                "not": {
                  "contains": {
                    "properties": {
                      "evidence_kind": {
                        "const": "INPUT_BINDING_DELTA"
                      }
                    },
                    "required": [
                      "evidence_kind"
                    ]
                  }
                }
              }
            }
          }
        }
      ]
    },
    "attack_target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attack_target_id",
        "issue_sha256",
        "warrant_sha256",
        "rival_id",
        "rival_claim",
        "falsifier_condition"
      ],
      "properties": {
        "attack_target_id": {
          "$ref": "#/$defs/attack_target_id"
        },
        "issue_sha256": {
          "$ref": "#/$defs/domain_sha256"
        },
        "warrant_sha256": {
          "$ref": "#/$defs/domain_sha256"
        },
        "rival_id": {
          "$ref": "#/$defs/identifier"
        },
        "rival_claim": {
          "$ref": "#/$defs/nonempty_string"
        },
        "falsifier_condition": {
          "$ref": "#/$defs/nonempty_string"
        }
      }
    },
    "research_target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issue_id",
        "issue_sha256",
        "warrant_id",
        "warrant_sha256",
        "attack_target_ids"
      ],
      "properties": {
        "issue_id": {
          "$ref": "#/$defs/identifier"
        },
        "issue_sha256": {
          "$ref": "#/$defs/domain_sha256"
        },
        "warrant_id": {
          "$ref": "#/$defs/identifier"
        },
        "warrant_sha256": {
          "$ref": "#/$defs/domain_sha256"
        },
        "attack_target_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/attack_target_id"
          }
        }
      }
    },
    "next_action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_id",
        "selected_assessment_ids",
        "route_intent",
        "action",
        "selection_basis",
        "reason",
        "research_target",
        "epistemic_effect",
        "can_rank_semantic_truth"
      ],
      "properties": {
        "action_id": {
          "type": "string",
          "pattern": "^NA:[0-9a-f]{64}$"
        },
        "selected_assessment_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/locus_assessment_id"
          }
        },
        "route_intent": {
          "type": "string",
          "enum": [
            "INTERNAL_HARNESS_WORK",
            "INTERNAL_MODEL_WORK",
            "AUTHORITY_REVIEW",
            "EXTERNAL_RESEARCH_REQUIRED"
          ]
        },
        "action": {
          "$ref": "#/$defs/nonempty_string"
        },
        "selection_basis": {
          "type": "string",
          "enum": [
            "UPSTREAM_DEPENDENCY",
            "INDEPENDENT_HUMAN_PRIORITY",
            "SHARED_ACTION_FOR_MULTIPLE_LOCI"
          ]
        },
        "reason": {
          "$ref": "#/$defs/nonempty_string"
        },
        "research_target": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/research_target"
            }
          ]
        },
        "epistemic_effect": {
          "const": "SCHEDULING_ONLY"
        },
        "can_rank_semantic_truth": {
          "const": false
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "route_intent": {
                "const": "EXTERNAL_RESEARCH_REQUIRED"
              }
            },
            "required": [
              "route_intent"
            ]
          },
          "then": {
            "properties": {
              "research_target": {
                "$ref": "#/$defs/research_target"
              }
            }
          },
          "else": {
            "properties": {
              "research_target": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "human_failure_triage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "$schema",
        "schema_version",
        "record_type",
        "triage_id",
        "sequence",
        "previous_triage_id",
        "transition_kind",
        "transition_reason",
        "created_on",
        "bindings",
        "overall_status",
        "locus_assessments",
        "assessment_dispositions",
        "next_action",
        "reviewer_kind",
        "machine_generated",
        "epistemic_effect",
        "can_promote_model",
        "semantic_verdict"
      ],
      "properties": {
        "$schema": {
          "const": "../schema/adaptive-inquiry-v2.schema.json"
        },
        "schema_version": {
          "const": "creib.semantic-forge.human-failure-triage.v2"
        },
        "record_type": {
          "const": "human_failure_triage"
        },
        "triage_id": {
          "$ref": "#/$defs/triage_id"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "previous_triage_id": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/triage_id"
            }
          ]
        },
        "transition_kind": {
          "type": "string",
          "enum": [
            "GENESIS",
            "SAME_BINDINGS",
            "INPUT_BINDING_CHANGED"
          ]
        },
        "transition_reason": {
          "$ref": "#/$defs/nonempty_string"
        },
        "created_on": {
          "$ref": "#/$defs/date"
        },
        "bindings": {
          "$ref": "#/$defs/bindings"
        },
        "overall_status": {
          "const": "UNRESOLVED"
        },
        "locus_assessments": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/locus_assessment"
          }
        },
        "assessment_dispositions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/assessment_disposition"
          }
        },
        "next_action": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/next_action"
            }
          ]
        },
        "reviewer_kind": {
          "const": "HUMAN"
        },
        "machine_generated": {
          "const": false
        },
        "epistemic_effect": {
          "const": "WORKFLOW_ROUTING_ONLY"
        },
        "can_promote_model": {
          "const": false
        },
        "semantic_verdict": {
          "type": "null"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "transition_kind": {
                "const": "GENESIS"
              }
            },
            "required": [
              "transition_kind"
            ]
          },
          "then": {
            "properties": {
              "sequence": {
                "const": 1
              },
              "previous_triage_id": {
                "type": "null"
              },
              "assessment_dispositions": {
                "maxItems": 0
              }
            }
          },
          "else": {
            "properties": {
              "sequence": {
                "minimum": 2
              },
              "previous_triage_id": {
                "$ref": "#/$defs/triage_id"
              }
            }
          }
        }
      ]
    },
    "critical_question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "question_id",
        "case_sha256",
        "triage_id",
        "action_id",
        "selected_assessment_ids",
        "selected_locus_assessments",
        "selected_action",
        "selection_reason",
        "issue_id",
        "issue_sha256",
        "warrant_id",
        "warrant_sha256",
        "model_binding_sha256",
        "trigger_observation_sha256",
        "triage_created_on",
        "attack_target",
        "attack_target_id",
        "rival_id",
        "rival_claim",
        "falsifier_condition",
        "purpose",
        "query",
        "expected_discriminator",
        "decision_relevance",
        "admissible_source_scope",
        "search_protocol",
        "epistemic_limit",
        "can_confirm_target_semantics",
        "source_count_can_promote",
        "provider_agreement_can_promote"
      ],
      "properties": {
        "schema_version": {
          "const": "creib.semantic-forge.critical-question.v2"
        },
        "question_id": {
          "type": "string",
          "pattern": "^IQ:[0-9a-f]{64}$"
        },
        "case_sha256": {
          "$ref": "#/$defs/domain_sha256"
        },
        "triage_id": {
          "type": "string",
          "pattern": "^HT:[0-9a-f]{64}$"
        },
        "action_id": {
          "type": "string",
          "pattern": "^NA:[0-9a-f]{64}$"
        },
        "selected_assessment_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/locus_assessment_id"
          }
        },
        "selected_locus_assessments": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/locus_assessment"
          }
        },
        "selected_action": {
          "$ref": "#/$defs/nonempty_string"
        },
        "selection_reason": {
          "$ref": "#/$defs/nonempty_string"
        },
        "issue_id": {
          "$ref": "#/$defs/identifier"
        },
        "issue_sha256": {
          "$ref": "#/$defs/domain_sha256"
        },
        "warrant_id": {
          "$ref": "#/$defs/identifier"
        },
        "warrant_sha256": {
          "$ref": "#/$defs/domain_sha256"
        },
        "model_binding_sha256": {
          "$ref": "#/$defs/domain_sha256"
        },
        "trigger_observation_sha256": {
          "$ref": "#/$defs/domain_sha256"
        },
        "triage_created_on": {
          "$ref": "#/$defs/date"
        },
        "attack_target": {
          "$ref": "#/$defs/attack_target"
        },
        "attack_target_id": {
          "$ref": "#/$defs/attack_target_id"
        },
        "rival_id": {
          "$ref": "#/$defs/identifier"
        },
        "rival_claim": {
          "$ref": "#/$defs/nonempty_string"
        },
        "falsifier_condition": {
          "$ref": "#/$defs/nonempty_string"
        },
        "purpose": {
          "const": "RIVAL_FALSIFIER"
        },
        "query": {
          "$ref": "#/$defs/nonempty_string"
        },
        "expected_discriminator": {
          "$ref": "#/$defs/nonempty_string"
        },
        "decision_relevance": {
          "$ref": "#/$defs/nonempty_string"
        },
        "admissible_source_scope": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonempty_string"
          }
        },
        "search_protocol": {
          "$ref": "#/$defs/search_protocol"
        },
        "epistemic_limit": {
          "$ref": "#/$defs/nonempty_string"
        },
        "can_confirm_target_semantics": {
          "const": false
        },
        "source_count_can_promote": {
          "const": false
        },
        "provider_agreement_can_promote": {
          "const": false
        }
      }
    },
    "inquiry_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "$schema",
        "schema_version",
        "record_type",
        "plan_id",
        "case_sha256",
        "route",
        "route_reason",
        "bindings",
        "triage",
        "live_locus_assessment_ids",
        "selected_action_id",
        "state_head_triage_id",
        "state_head_event_id",
        "available_attack_targets",
        "proposed_questions",
        "question_state",
        "semantic_verdict",
        "epistemic_status",
        "epistemic_effect",
        "epistemic_limit"
      ],
      "properties": {
        "$schema": {
          "const": "../schema/adaptive-inquiry-v2.schema.json"
        },
        "schema_version": {
          "const": "creib.semantic-forge.adaptive-inquiry-plan.v2"
        },
        "record_type": {
          "const": "adaptive_inquiry_plan"
        },
        "plan_id": {
          "type": "string",
          "pattern": "^AIP:[0-9a-f]{64}$"
        },
        "case_sha256": {
          "$ref": "#/$defs/domain_sha256"
        },
        "route": {
          "type": "string",
          "enum": [
            "AWAITING_HUMAN_TRIAGE",
            "AWAITING_HUMAN_ACTION_SELECTION",
            "AWAITING_HUMAN_REASSESSMENT",
            "INTERNAL_HARNESS_WORK",
            "INTERNAL_MODEL_WORK",
            "AUTHORITY_REVIEW",
            "POLICY_BLOCKED",
            "EXTERNAL_RESEARCH_REQUIRED",
            "RESEARCH_IN_PROGRESS",
            "AWAITING_HUMAN_REVIEW",
            "INTERNAL_INTEGRATION_REQUIRED",
            "NO_NEW_RESEARCH_UNDER_CURRENT_PROTOCOL"
          ]
        },
        "route_reason": {
          "$ref": "#/$defs/nonempty_string"
        },
        "bindings": {
          "$ref": "#/$defs/bindings"
        },
        "triage": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/human_failure_triage"
            }
          ]
        },
        "live_locus_assessment_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/locus_assessment_id"
          }
        },
        "selected_action_id": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^NA:[0-9a-f]{64}$"
            }
          ]
        },
        "state_head_triage_id": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/triage_id"
            }
          ]
        },
        "state_head_event_id": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^IE:[0-9a-f]{64}$"
            }
          ]
        },
        "available_attack_targets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/attack_target"
          }
        },
        "proposed_questions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/critical_question"
          }
        },
        "question_state": {
          "type": "object",
          "propertyNames": {
            "pattern": "^IQ:[0-9a-f]{64}$"
          },
          "additionalProperties": {
            "type": "string",
            "enum": [
              "PROPOSED",
              "ACTIVE",
              "AWAITING_HUMAN_REVIEW",
              "RETIRED_WITH_CRITICISM_CANDIDATE",
              "RETIRED_NONDISCRIMINATING",
              "RETIRED_MISFRAMED",
              "RETIRED_OUT_OF_SCOPE",
              "STALE_BY_MODEL_CHANGE"
            ]
          }
        },
        "semantic_verdict": {
          "type": "null"
        },
        "epistemic_status": {
          "const": "UNRESOLVED"
        },
        "epistemic_effect": {
          "const": "WORKFLOW_ROUTING_ONLY"
        },
        "epistemic_limit": {
          "$ref": "#/$defs/nonempty_string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "triage": {
                "type": "null"
              }
            },
            "required": [
              "triage"
            ]
          },
          "then": {
            "properties": {
              "route": {
                "const": "AWAITING_HUMAN_TRIAGE"
              },
              "live_locus_assessment_ids": {
                "maxItems": 0
              },
              "selected_action_id": {
                "type": "null"
              },
              "state_head_triage_id": {
                "type": "null"
              },
              "proposed_questions": {
                "maxItems": 0
              },
              "question_state": {
                "maxProperties": 0
              }
            }
          },
          "else": {
            "properties": {
              "state_head_triage_id": {
                "$ref": "#/$defs/triage_id"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "triage": {
                "type": "object",
                "properties": {
                  "next_action": {
                    "type": "null"
                  }
                },
                "required": [
                  "next_action"
                ]
              }
            },
            "required": [
              "triage"
            ]
          },
          "then": {
            "properties": {
              "route": {
                "enum": [
                  "AWAITING_HUMAN_ACTION_SELECTION",
                  "AWAITING_HUMAN_REASSESSMENT"
                ]
              },
              "selected_action_id": {
                "type": "null"
              },
              "proposed_questions": {
                "maxItems": 0
              },
              "question_state": {
                "maxProperties": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "triage": {
                "type": "object",
                "properties": {
                  "next_action": {
                    "type": "object"
                  }
                },
                "required": [
                  "next_action"
                ]
              }
            },
            "required": [
              "triage"
            ]
          },
          "then": {
            "properties": {
              "selected_action_id": {
                "type": "string",
                "pattern": "^NA:[0-9a-f]{64}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "question_state": {
                "minProperties": 1
              }
            },
            "required": [
              "question_state"
            ]
          },
          "then": {
            "properties": {
              "state_head_event_id": {
                "type": "string",
                "pattern": "^IE:[0-9a-f]{64}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "route": {
                "const": "POLICY_BLOCKED"
              },
              "route_reason": {
                "const": "Event history changed a bound question."
              }
            },
            "required": [
              "route",
              "route_reason"
            ]
          },
          "then": {
            "properties": {
              "state_head_event_id": {
                "type": "string",
                "pattern": "^IE:[0-9a-f]{64}$"
              }
            }
          }
        }
      ]
    }
  }
}
