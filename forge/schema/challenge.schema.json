{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ahepi.example/smf/0.1/challenge.schema.json",
  "title": "SMF-0.1 runtime-compatible minimal pair",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "challenge_id",
    "defect_type",
    "intended_case",
    "lookalike_case",
    "held_fixed",
    "controlled_difference",
    "oracle",
    "falsifies_if",
    "epistemic_limit"
  ],
  "properties": {
    "schema_version": {
      "const": "creib.semantic-forge.minimal-pair.v1"
    },
    "challenge_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
    },
    "defect_type": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,127}$"
    },
    "intended_case": {
      "type": "string",
      "minLength": 1,
      "pattern": ".*\\S.*"
    },
    "lookalike_case": {
      "type": "string",
      "minLength": 1,
      "pattern": ".*\\S.*"
    },
    "held_fixed": {
      "type": "string",
      "minLength": 1,
      "pattern": ".*\\S.*"
    },
    "controlled_difference": {
      "type": "string",
      "minLength": 1,
      "pattern": ".*\\S.*"
    },
    "oracle": {
      "type": "string",
      "minLength": 1,
      "pattern": "^status=(source_scoped|interpretation_provisional|project_import_provisional);[^\\r\\n]*\\S[^\\r\\n]*$"
    },
    "falsifies_if": {
      "type": "string",
      "minLength": 1,
      "pattern": ".*\\S.*"
    },
    "epistemic_limit": {
      "const": "Survival of criticism leaves a claim unrefuted; pass counts, consensus, and confidence do not justify it."
    }
  }
}
