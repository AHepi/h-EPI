{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ahepi.example/smf/0.3/inquiry-event-v2.schema.json",
  "title": "SMF append-only inquiry event v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "event_id",
    "ledger_id",
    "sequence",
    "previous_event_id",
    "event_type",
    "occurred_on",
    "actor_kind",
    "question",
    "from_state",
    "to_state",
    "reason_code",
    "reason",
    "research_ledger",
    "research_entry",
    "research_entry_sha256",
    "semantic_verdict",
    "epistemic_effect"
  ],
  "properties": {
    "$schema": {
      "const": "../schema/inquiry-event-v2.schema.json"
    },
    "schema_version": {
      "const": "creib.semantic-forge.inquiry-event.v2"
    },
    "event_id": {
      "type": "string",
      "pattern": "^IE:[0-9a-f]{64}$"
    },
    "ledger_id": {
      "const": "SMF-INQUIRY-CR-1-0"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "previous_event_id": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^IE:[0-9a-f]{64}$"
        }
      ]
    },
    "event_type": {
      "type": "string",
      "enum": [
        "QUESTION_PROPOSED",
        "QUESTION_ACTIVATED",
        "RESEARCH_CANDIDATE_RECORDED",
        "HUMAN_CRITICISM_RETAINED",
        "HUMAN_NONDISCRIMINATING",
        "HUMAN_MISFRAMED",
        "HUMAN_OUT_OF_SCOPE",
        "MODEL_CHANGED"
      ]
    },
    "occurred_on": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "actor_kind": {
      "type": "string",
      "enum": [
        "MACHINE",
        "HUMAN",
        "OPERATOR"
      ]
    },
    "question": {
      "$ref": "https://ahepi.example/smf/0.3/adaptive-inquiry-v2.schema.json#/$defs/critical_question"
    },
    "from_state": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "enum": [
            "PROPOSED",
            "ACTIVE",
            "AWAITING_HUMAN_REVIEW"
          ]
        }
      ]
    },
    "to_state": {
      "type": "string",
      "enum": [
        "PROPOSED",
        "ACTIVE",
        "AWAITING_HUMAN_REVIEW",
        "RETIRED_WITH_CRITICISM_CANDIDATE",
        "RETIRED_NONDISCRIMINATING",
        "RETIRED_MISFRAMED",
        "RETIRED_OUT_OF_SCOPE",
        "STALE_BY_MODEL_CHANGE"
      ]
    },
    "reason_code": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{0,127}$"
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "pattern": ".*\\S.*"
    },
    "research_ledger": {
      "$ref": "https://ahepi.example/smf/0.3/adaptive-inquiry-v2.schema.json#/$defs/research_ledger_binding"
    },
    "research_entry": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/event_research_entry"
        }
      ]
    },
    "research_entry_sha256": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      ]
    },
    "semantic_verdict": {
      "type": "null"
    },
    "epistemic_effect": {
      "const": "MAY_CRITICIZE_OR_ROUTE_WORK_ONLY"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "RESEARCH_CANDIDATE_RECORDED"
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "properties": {
          "research_entry": {
            "$ref": "#/$defs/event_research_entry"
          },
          "research_entry_sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        }
      },
      "else": {
        "properties": {
          "research_entry": {
            "type": "null"
          },
          "research_entry_sha256": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "sequence": {
            "const": 1
          }
        },
        "required": [
          "sequence"
        ]
      },
      "then": {
        "properties": {
          "previous_event_id": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "previous_event_id": {
            "type": "string",
            "pattern": "^IE:[0-9a-f]{64}$"
          }
        }
      }
    },
    {
      "oneOf": [
        {
          "properties": {
            "event_type": {"const": "QUESTION_PROPOSED"},
            "actor_kind": {"const": "MACHINE"},
            "from_state": {"type": "null"},
            "to_state": {"const": "PROPOSED"}
          }
        },
        {
          "properties": {
            "event_type": {"const": "QUESTION_ACTIVATED"},
            "actor_kind": {"const": "HUMAN"},
            "from_state": {"const": "PROPOSED"},
            "to_state": {"const": "ACTIVE"}
          }
        },
        {
          "properties": {
            "event_type": {"const": "RESEARCH_CANDIDATE_RECORDED"},
            "actor_kind": {"const": "OPERATOR"},
            "from_state": {"const": "ACTIVE"},
            "to_state": {"const": "AWAITING_HUMAN_REVIEW"}
          }
        },
        {
          "properties": {
            "event_type": {"const": "HUMAN_CRITICISM_RETAINED"},
            "actor_kind": {"const": "HUMAN"},
            "from_state": {"const": "AWAITING_HUMAN_REVIEW"},
            "to_state": {"const": "RETIRED_WITH_CRITICISM_CANDIDATE"}
          }
        },
        {
          "properties": {
            "event_type": {"const": "HUMAN_NONDISCRIMINATING"},
            "actor_kind": {"const": "HUMAN"},
            "from_state": {"const": "AWAITING_HUMAN_REVIEW"},
            "to_state": {"const": "RETIRED_NONDISCRIMINATING"}
          }
        },
        {
          "properties": {
            "event_type": {"const": "HUMAN_MISFRAMED"},
            "actor_kind": {"const": "HUMAN"},
            "from_state": {
              "enum": ["PROPOSED", "ACTIVE", "AWAITING_HUMAN_REVIEW"]
            },
            "to_state": {"const": "RETIRED_MISFRAMED"}
          }
        },
        {
          "properties": {
            "event_type": {"const": "HUMAN_OUT_OF_SCOPE"},
            "actor_kind": {"const": "HUMAN"},
            "from_state": {
              "enum": ["PROPOSED", "ACTIVE", "AWAITING_HUMAN_REVIEW"]
            },
            "to_state": {"const": "RETIRED_OUT_OF_SCOPE"}
          }
        },
        {
          "properties": {
            "event_type": {"const": "MODEL_CHANGED"},
            "actor_kind": {"const": "MACHINE"},
            "from_state": {
              "enum": ["PROPOSED", "ACTIVE", "AWAITING_HUMAN_REVIEW"]
            },
            "to_state": {"const": "STALE_BY_MODEL_CHANGE"}
          }
        }
      ]
    }
  ],
  "$defs": {
    "question_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question_id",
        "case_sha256",
        "triage_id",
        "action_id",
        "attack_target_id"
      ],
      "properties": {
        "question_id": {
          "type": "string",
          "pattern": "^IQ:[0-9a-f]{64}$"
        },
        "case_sha256": {
          "$ref": "https://ahepi.example/smf/0.3/adaptive-inquiry-v2.schema.json#/$defs/domain_sha256"
        },
        "triage_id": {
          "$ref": "https://ahepi.example/smf/0.3/adaptive-inquiry-v2.schema.json#/$defs/triage_id"
        },
        "action_id": {
          "type": "string",
          "pattern": "^NA:[0-9a-f]{64}$"
        },
        "attack_target_id": {
          "$ref": "https://ahepi.example/smf/0.3/adaptive-inquiry-v2.schema.json#/$defs/attack_target_id"
        }
      }
    },
    "event_research_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "question_binding",
        "source_report"
      ],
      "properties": {
        "schema_version": {
          "const": "creib.semantic-forge.event-research-entry.v2"
        },
        "question_binding": {
          "$ref": "#/$defs/question_binding"
        },
        "source_report": {
          "$ref": "https://ahepi.example/smf/0.2/research-ledger.schema.json#/$defs/research_entry"
        }
      }
    }
  }
}
