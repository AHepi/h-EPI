{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ahepi.example/smf/0.4/inquiry-input-v1.schema.json",
  "title": "SMF stage-neutral inquiry input v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "record_type",
    "input_id",
    "producer_contract_sha256",
    "authority_bindings",
    "component_bindings",
    "observation",
    "research_basis",
    "epistemic_effect",
    "semantic_verdict"
  ],
  "properties": {
    "$schema": {
      "const": "../schema/inquiry-input-v1.schema.json"
    },
    "schema_version": {
      "const": "creib.semantic-forge.inquiry-input.v1"
    },
    "record_type": {
      "const": "inquiry_input"
    },
    "input_id": {
      "type": "string",
      "pattern": "^II:[0-9a-f]{64}$"
    },
    "producer_contract_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "authority_bindings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/authority_binding"
      }
    },
    "component_bindings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/component_binding"
      }
    },
    "observation": {
      "$ref": "#/$defs/input_observation_value"
    },
    "research_basis": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/research_basis"
        }
      ]
    },
    "epistemic_effect": {
      "const": "CRITICISM_CANDIDATE_ONLY"
    },
    "semantic_verdict": {
      "type": "null"
    }
  },
  "$defs": {
    "nonempty_string": {
      "type": "string",
      "minLength": 1,
      "pattern": ".*\\S.*"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "canonical_value": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "integer"
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/canonical_value"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/canonical_value"
          }
        }
      ]
    },
    "authority_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "authority_id",
        "file_sha256"
      ],
      "properties": {
        "role": {
          "$ref": "#/$defs/identifier"
        },
        "authority_id": {
          "$ref": "#/$defs/identifier"
        },
        "file_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "component_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "subject_id",
        "binding_kind",
        "sha256"
      ],
      "properties": {
        "role": {
          "$ref": "#/$defs/identifier"
        },
        "subject_id": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/identifier"
            }
          ]
        },
        "binding_kind": {
          "type": "string",
          "enum": [
            "CANONICAL_RECORD",
            "CONTRACT",
            "FILE_BYTES",
            "VALUE"
          ]
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "input_observation_value": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observation_domain",
        "selected_value",
        "observation_kind",
        "semantic_verdict"
      ],
      "properties": {
        "observation_domain": {
          "type": "string",
          "enum": [
            "HARNESS_TEST",
            "LEGACY_CALIBRATION",
            "MATHEMATICAL_EXTRACTION",
            "ROUND_TRIP",
            "SEMANTIC_MODEL",
            "SOURCE_TRANSLATION"
          ]
        },
        "selected_value": {
          "$ref": "#/$defs/canonical_value"
        },
        "observation_kind": {
          "const": "CRITICISM_CANDIDATE_NOT_SEMANTIC_VERDICT"
        },
        "semantic_verdict": {
          "type": "null"
        }
      }
    },
    "rival": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rival_id",
        "claim",
        "falsifier_conditions"
      ],
      "properties": {
        "rival_id": {
          "$ref": "#/$defs/identifier"
        },
        "claim": {
          "$ref": "#/$defs/nonempty_string"
        },
        "falsifier_conditions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonempty_string"
          }
        }
      }
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "issue_id",
        "question",
        "unknown_kind",
        "decision",
        "decision_relevance",
        "rivals",
        "expected_discriminator",
        "admissible_source_scope",
        "stop_condition"
      ],
      "properties": {
        "schema_version": {
          "const": "creib.semantic-forge.issue.v1"
        },
        "issue_id": {
          "$ref": "#/$defs/identifier"
        },
        "question": {
          "$ref": "#/$defs/nonempty_string"
        },
        "unknown_kind": {
          "const": "external"
        },
        "decision": {
          "$ref": "#/$defs/nonempty_string"
        },
        "decision_relevance": {
          "$ref": "#/$defs/nonempty_string"
        },
        "rivals": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/rival"
          }
        },
        "expected_discriminator": {
          "$ref": "#/$defs/nonempty_string"
        },
        "admissible_source_scope": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonempty_string"
          }
        },
        "stop_condition": {
          "$ref": "#/$defs/nonempty_string"
        }
      }
    },
    "warrant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "warrant_id",
        "issue_id",
        "question",
        "unknown_kind",
        "decision",
        "decision_relevance",
        "rivals",
        "expected_discriminator",
        "admissible_source_scope",
        "stop_condition",
        "discovery_channels",
        "proposal_status",
        "epistemic_limit"
      ],
      "properties": {
        "schema_version": {
          "const": "creib.semantic-forge.research-warrant.v1"
        },
        "warrant_id": {
          "$ref": "#/$defs/identifier"
        },
        "issue_id": {
          "$ref": "#/$defs/identifier"
        },
        "question": {
          "$ref": "#/$defs/nonempty_string"
        },
        "unknown_kind": {
          "const": "external"
        },
        "decision": {
          "$ref": "#/$defs/nonempty_string"
        },
        "decision_relevance": {
          "$ref": "#/$defs/nonempty_string"
        },
        "rivals": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/rival"
          }
        },
        "expected_discriminator": {
          "$ref": "#/$defs/nonempty_string"
        },
        "admissible_source_scope": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonempty_string"
          }
        },
        "stop_condition": {
          "$ref": "#/$defs/nonempty_string"
        },
        "discovery_channels": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonempty_string"
          }
        },
        "proposal_status": {
          "const": "PROPOSED"
        },
        "epistemic_limit": {
          "$ref": "#/$defs/nonempty_string"
        }
      }
    },
    "research_basis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issue",
        "warrant"
      ],
      "properties": {
        "issue": {
          "$ref": "#/$defs/issue"
        },
        "warrant": {
          "$ref": "#/$defs/warrant"
        }
      }
    }
  }
}
