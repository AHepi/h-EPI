{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ahepi.example/smf/0.5/conformance-run.schema.json",
  "title": "SMF-0.5 task-conformance run record",
  "description": "One model's pass over a plan. Counts are plural tallies for human reading, never a score; the overall status is always UNRESOLVED and the route is always human triage.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "content_digest",
    "pilot_id",
    "plan_id",
    "model",
    "endpoint",
    "executor_kind",
    "spec_bindings",
    "created_on",
    "selected_families",
    "variant_limit",
    "observation_ids",
    "family_counts",
    "response_verdict_counts",
    "field_verdict_counts",
    "live_locus_counts",
    "observations_with_live_loci",
    "model_call_count",
    "transport_error_count",
    "scope_label",
    "overall_status",
    "route",
    "epistemic_limit",
    "format_enforced_by_server"
  ],
  "properties": {
    "schema_version": {
      "const": "creib.conformance-pilot.run.v1"
    },
    "run_id": {
      "$ref": "#/$defs/hex_digest"
    },
    "content_digest": {
      "$ref": "#/$defs/hex_digest"
    },
    "pilot_id": {
      "$ref": "#/$defs/identifier"
    },
    "plan_id": {
      "$ref": "#/$defs/hex_digest"
    },
    "model": {
      "$ref": "#/$defs/model_id"
    },
    "endpoint": {
      "$ref": "#/$defs/endpoint"
    },
    "executor_kind": {
      "type": "string",
      "enum": [
        "ollama-chat",
        "fake",
        "replay",
        "canned"
      ]
    },
    "spec_bindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/binding"
      }
    },
    "created_on": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "selected_families": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/family"
      }
    },
    "variant_limit": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "observation_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/hex_digest"
      }
    },
    "family_counts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "family",
          "count"
        ],
        "properties": {
          "family": {
            "$ref": "#/$defs/family"
          },
          "count": {
            "$ref": "#/$defs/count"
          }
        }
      }
    },
    "response_verdict_counts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "verdict",
          "count"
        ],
        "properties": {
          "verdict": {
            "type": "string",
            "enum": [
              "JSON_OBJECT",
              "TRANSPORT_ERROR",
              "EMPTY_RESPONSE",
              "TRUNCATED",
              "INVALID_JSON",
              "NOT_AN_OBJECT",
              "REFUSAL_SUSPECTED",
              "NO_MODEL_CALL",
              "PREREQUISITE_UNAVAILABLE"
            ]
          },
          "count": {
            "$ref": "#/$defs/count"
          }
        }
      }
    },
    "field_verdict_counts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "verdict",
          "count"
        ],
        "properties": {
          "verdict": {
            "type": "string",
            "enum": [
              "MATCH",
              "MISMATCH",
              "MISSING_REQUIRED",
              "EXTRA_FIELD",
              "TYPE_VIOLATION",
              "PATTERN_VIOLATION",
              "ENUM_VIOLATION",
              "LENGTH_VIOLATION",
              "UNEXPECTED_PRESENT",
              "NOT_SCORED"
            ]
          },
          "count": {
            "$ref": "#/$defs/count"
          }
        }
      }
    },
    "live_locus_counts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "locus",
          "count"
        ],
        "properties": {
          "locus": {
            "type": "string",
            "enum": [
              "CANDIDATE",
              "AUXILIARY",
              "TEST",
              "SCOPE"
            ]
          },
          "count": {
            "$ref": "#/$defs/count"
          }
        }
      }
    },
    "observations_with_live_loci": {
      "$ref": "#/$defs/count"
    },
    "model_call_count": {
      "$ref": "#/$defs/count"
    },
    "transport_error_count": {
      "$ref": "#/$defs/count"
    },
    "scope_label": {
      "type": "string",
      "enum": [
        "REFUTED_CASES_PRESENT",
        "UNREFUTED_FOR_DECLARED_SCOPE",
        "INCONCLUSIVE_NO_SCORED_OUTPUT"
      ]
    },
    "overall_status": {
      "const": "UNRESOLVED"
    },
    "route": {
      "const": "AWAITING_HUMAN_TRIAGE"
    },
    "epistemic_limit": {
      "const": "Survival of criticism leaves a claim unrefuted; pass counts, consensus, and confidence do not justify it."
    },
    "format_enforced_by_server": {
      "type": [
        "boolean",
        "null"
      ]
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
    },
    "model_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
    },
    "hex_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "family": {
      "type": "string",
      "enum": [
        "BASELINE",
        "DELETION",
        "NEGATION",
        "RIVAL_SUBSTITUTION",
        "SEMANTIC_ROLE_TWIN",
        "SUBSTRATE_SWAP",
        "BOUNDARY_SHIFT",
        "IMPORT_DEPENDENCY",
        "NON_VACUITY",
        "ROUND_TRIP"
      ]
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,255}$"
        },
        "sha256": {
          "$ref": "#/$defs/hex_digest"
        }
      }
    },
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "base_url",
        "timeout_seconds",
        "options",
        "think"
      ],
      "properties": {
        "kind": {
          "const": "ollama-chat"
        },
        "base_url": {
          "type": "string",
          "pattern": "^https?://[^\\s/]+(/[^\\s]*)?$"
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        },
        "options": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "temperature",
            "seed"
          ],
          "properties": {
            "temperature": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2
            },
            "seed": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "think": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    }
  }
}
