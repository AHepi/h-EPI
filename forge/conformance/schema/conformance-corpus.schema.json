{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ahepi.example/smf/0.5/conformance-corpus.schema.json",
  "title": "SMF-0.5 task-conformance case corpus",
  "description": "Case documents with per-field oracles. Every oracle carries a non-final status and a rationale; an oracle is a proposed expectation, never a ground truth.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "corpus_id",
    "cases"
  ],
  "properties": {
    "schema_version": {
      "const": "creib.conformance-pilot.corpus.v1"
    },
    "corpus_id": {
      "$ref": "#/$defs/identifier"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "$defs": {
    "nonempty_string": {
      "type": "string",
      "minLength": 1,
      "pattern": ".*\\S.*"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
    },
    "field_name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    },
    "scalar": {
      "type": [
        "string",
        "boolean",
        "integer",
        "null"
      ]
    },
    "rendering": {
      "type": "string",
      "enum": [
        "prose",
        "table",
        "email"
      ]
    },
    "oracle_status": {
      "type": "string",
      "enum": [
        "source_scoped",
        "interpretation_provisional",
        "project_import_provisional"
      ]
    },
    "oracle_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field",
        "kind",
        "value",
        "values",
        "pattern",
        "oracle_status",
        "rationale"
      ],
      "properties": {
        "field": {
          "$ref": "#/$defs/field_name"
        },
        "kind": {
          "type": "string",
          "enum": [
            "exact",
            "regex",
            "enum",
            "absent",
            "any_of"
          ]
        },
        "value": {
          "$ref": "#/$defs/scalar"
        },
        "values": {
          "type": [
            "array",
            "null"
          ],
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/scalar"
          }
        },
        "pattern": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "oracle_status": {
          "$ref": "#/$defs/oracle_status"
        },
        "rationale": {
          "$ref": "#/$defs/nonempty_string"
        }
      }
    },
    "field_value": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field",
        "value"
      ],
      "properties": {
        "field": {
          "$ref": "#/$defs/field_name"
        },
        "value": {
          "$ref": "#/$defs/scalar"
        }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "boundary",
        "rendering",
        "renderings",
        "expected",
        "held_fixed",
        "varied",
        "pair_of",
        "reference_output",
        "rival_expected",
        "notes"
      ],
      "properties": {
        "case_id": {
          "$ref": "#/$defs/identifier"
        },
        "boundary": {
          "type": "boolean"
        },
        "rendering": {
          "$ref": "#/$defs/rendering"
        },
        "renderings": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "prose": {
              "$ref": "#/$defs/nonempty_string"
            },
            "table": {
              "$ref": "#/$defs/nonempty_string"
            },
            "email": {
              "$ref": "#/$defs/nonempty_string"
            }
          }
        },
        "expected": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/oracle_entry"
          }
        },
        "held_fixed": {
          "$ref": "#/$defs/nonempty_string"
        },
        "varied": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "pair_of": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
        },
        "reference_output": {
          "type": [
            "array",
            "null"
          ],
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/field_value"
          }
        },
        "rival_expected": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "field",
              "label",
              "oracle"
            ],
            "properties": {
              "field": {
                "$ref": "#/$defs/field_name"
              },
              "label": {
                "$ref": "#/$defs/identifier"
              },
              "oracle": {
                "$ref": "#/$defs/oracle_entry"
              }
            }
          }
        },
        "notes": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      }
    }
  }
}
