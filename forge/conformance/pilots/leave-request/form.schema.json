{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Leave request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "employee_name",
    "leave_type",
    "start_date",
    "end_date",
    "total_days",
    "reason",
    "manager_notified"
  ],
  "properties": {
    "employee_name": {
      "type": "string"
    },
    "leave_type": {
      "type": "string",
      "enum": [
        "annual",
        "sick",
        "carer",
        "unpaid"
      ]
    },
    "start_date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "end_date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "total_days": {
      "type": "integer"
    },
    "reason": {
      "type": "string",
      "maxLength": 160
    },
    "manager_notified": {
      "type": "boolean"
    }
  }
}
