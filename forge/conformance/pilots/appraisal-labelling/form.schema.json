{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Appraisal labelling",
  "description": "The label of each of six arguments in an appraisal dossier under the stated policy, the count of usable arguments, and the raw and usable case summaries.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "label_a1",
    "label_a2",
    "label_a3",
    "label_a4",
    "label_a5",
    "label_a6",
    "usable_count",
    "raw_summary",
    "usable_summary"
  ],
  "properties": {
    "label_a1": {"type": "string", "description": "Label of argument A1.", "enum": ["in", "out", "undecided"]},
    "label_a2": {"type": "string", "description": "Label of argument A2.", "enum": ["in", "out", "undecided"]},
    "label_a3": {"type": "string", "description": "Label of argument A3.", "enum": ["in", "out", "undecided"]},
    "label_a4": {"type": "string", "description": "Label of argument A4.", "enum": ["in", "out", "undecided"]},
    "label_a5": {"type": "string", "description": "Label of argument A5.", "enum": ["in", "out", "undecided"]},
    "label_a6": {"type": "string", "description": "Label of argument A6.", "enum": ["in", "out", "undecided"]},
    "usable_count": {"type": "integer", "description": "How many of the six arguments are labelled in."},
    "raw_summary": {"type": "string", "description": "Presence of attached cases by polarity, whatever their argument's label.", "enum": ["NO_CASE", "POSITIVE_CASE_ONLY", "NEGATIVE_CASE_ONLY", "BOTH_CASES"]},
    "usable_summary": {"type": "string", "description": "Presence of attached cases by polarity, counting only cases on arguments labelled in.", "enum": ["NO_CASE", "POSITIVE_CASE_ONLY", "NEGATIVE_CASE_ONLY", "BOTH_CASES"]}
  }
}
