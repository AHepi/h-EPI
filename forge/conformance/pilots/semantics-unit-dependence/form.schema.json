{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Unit dependence probe",
  "description": "Whether a claim follows from a document as written, and which of the document's named commitments and defined terms it depends on.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "follows",
    "essential"
  ],
  "properties": {
    "follows": {
      "type": "string",
      "description": "Whether the claim under assessment follows from the document as written.",
      "enum": [
        "follows",
        "does_not_follow",
        "not_determined"
      ]
    },
    "essential": {
      "type": "array",
      "description": "The named commitments and defined terms the claim depends on essentially; may be empty.",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "Account",
          "Attempt",
          "Authors",
          "Bearing",
          "Can",
          "Capacity",
          "Enable",
          "Essential",
          "K-CONJECTURE",
          "K-CRITICISM",
          "K-ORIGIN",
          "K-PHYSICALITY",
          "K-PROBLEM",
          "K-PROGRESS",
          "K-REAL",
          "K-RECURSION",
          "K-UNIVERSALITY",
          "Licensed",
          "New",
          "OCA",
          "Progress",
          "RecursiveCapacity",
          "Standing",
          "UC",
          "UED",
          "UU",
          "Usable",
          "adv",
          "understand"
        ]
      }
    }
  }
}
