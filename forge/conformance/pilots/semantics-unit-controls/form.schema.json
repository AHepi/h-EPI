{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Unit dependence controls",
  "description": "Whether a claim follows from a document as written, and which of the document's named commitments and defined terms it depends on; the closed list carries the document's vocabulary and the renamed vocabulary of the renamed control.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "follows",
    "essential"
  ],
  "properties": {
    "follows": {
      "type": "string",
      "description": "Whether the claim under assessment follows from the document as written.",
      "enum": [
        "follows",
        "does_not_follow",
        "not_determined"
      ]
    },
    "essential": {
      "type": "array",
      "description": "The named commitments and defined terms the claim depends on essentially; may be empty.",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "Account",
          "Attempt",
          "Authors",
          "Bearing",
          "Can",
          "Capacity",
          "Enable",
          "Essential",
          "K-CONJECTURE",
          "K-CRITICISM",
          "K-ORIGIN",
          "K-PHYSICALITY",
          "K-PROBLEM",
          "K-PROGRESS",
          "K-REAL",
          "K-RECURSION",
          "K-UNIVERSALITY",
          "Licensed",
          "New",
          "OCA",
          "Progress",
          "RecursiveCapacity",
          "Standing",
          "UC",
          "UED",
          "UU",
          "Usable",
          "adv",
          "understand",
          "TermAlpha",
          "TermBeta",
          "TermGamma",
          "TermDelta",
          "TermEpsilon",
          "TermZeta",
          "TermEta",
          "TermTheta",
          "K-ALPHA",
          "K-BETA",
          "K-GAMMA",
          "K-DELTA",
          "K-EPSILON",
          "K-ZETA",
          "K-ETA",
          "K-THETA",
          "K-IOTA",
          "TermIota",
          "TermKappa",
          "XK",
          "TermMu",
          "TermNu",
          "TermXi",
          "XO",
          "XP",
          "XQ",
          "TermSigma",
          "TermTau",
          "TermUpsilon"
        ]
      }
    }
  }
}
