{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ahepi.example/mini/0.1/mini-manifest.schema.json",
  "title": "One mini run manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_id",
    "problem",
    "kinds",
    "stages"
  ],
  "properties": {
    "schema_version": {
      "const": "creib.mini.manifest.v1"
    },
    "manifest_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "problem": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    },
    "tiers": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/tier"
      }
    },
    "port_types": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/port_type"
      }
    },
    "kinds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "oneOf": [
          {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          {
            "$ref": "https://ahepi.example/mini/0.1/mini-kind.schema.json#/$defs/kind"
          }
        ]
      }
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/stage"
      }
    },
    "routing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "artifacts": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/artifact_route"
          }
        },
        "evidence": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/evidence_route"
          }
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base"
      ],
      "properties": {
        "base": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "grants": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "https://ahepi.example/mini/0.1/mini-policy.schema.json#/$defs/grant"
          }
        }
      }
    },
    "attention": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy"
      ],
      "properties": {
        "policy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "sources": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "cycles": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_cycles": {
          "type": "integer"
        },
        "max_calls": {
          "type": [
            "integer",
            "null"
          ]
        },
        "stop_condition": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    }
  },
  "$defs": {
    "tier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tier"
      ],
      "properties": {
        "tier": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      }
    },
    "port_type": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "port_type",
        "draws_from",
        "render"
      ],
      "properties": {
        "port_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "draws_from": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "artifact_kinds": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "maxItems": 32
            },
            "evidence_tiers": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "maxItems": 16
            }
          }
        },
        "render": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "rule"
          ],
          "properties": {
            "rule": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "header": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          }
        }
      }
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage_id"
      ],
      "properties": {
        "stage_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "kind_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "ports": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "maxItems": 32
        },
        "end": {
          "type": "boolean"
        },
        "max_repeats": {
          "type": "integer"
        },
        "seat": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16
        }
      }
    },
    "artifact_route": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from_kind",
        "to"
      ],
      "properties": {
        "from_kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "to": {
          "$ref": "#/$defs/destination"
        }
      }
    },
    "evidence_route": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from_tier",
        "to"
      ],
      "properties": {
        "from_tier": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "to": {
          "$ref": "#/$defs/destination"
        }
      }
    },
    "destination": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target"
      ],
      "properties": {
        "target": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "stage_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "port_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "port_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "tier": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "destination": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 262144
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "tier": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      }
    }
  }
}
