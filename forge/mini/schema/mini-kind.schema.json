{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ahepi.example/mini/0.1/mini-kind.schema.json",
  "title": "One artifact kind: the generic template, filled in",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind"
  ],
  "properties": {
    "schema_version": {
      "const": "creib.mini.kind.v1"
    },
    "kind": {
      "$ref": "#/$defs/kind"
    }
  },
  "$defs": {
    "kind": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind_id",
        "title",
        "input_ports",
        "output_port"
      ],
      "properties": {
        "kind_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "input_ports": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/input_port"
          },
          "maxItems": 32
        },
        "output_port": {
          "$ref": "#/$defs/output_port"
        },
        "optional_fields": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "maxItems": 16
        },
        "format": {
          "$ref": "#/$defs/format_spec"
        },
        "failure_policy": {
          "$ref": "#/$defs/failure_policy"
        },
        "commitment_call": {
          "type": "string"
        },
        "commitment_ports": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 32
        },
        "instruction": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000,
          "description": "What this kind of seat is asked to do, shown at the head of every brief for the kind. Absent, nothing is shown and no header key is written."
        }
      }
    },
    "input_port": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "port_id",
        "port_type"
      ],
      "properties": {
        "port_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "port_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "params": {
          "type": "object"
        },
        "window": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 32
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "last_n"
              ],
              "properties": {
                "last_n": {
                  "type": "integer"
                }
              }
            }
          ]
        }
      }
    },
    "output_port": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "port_id",
        "produces_kind"
      ],
      "properties": {
        "port_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "produces_kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "format_spec": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "body": {
          "$ref": "#/$defs/field_format"
        },
        "commitments": {
          "$ref": "#/$defs/field_format"
        },
        "fields": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 16,
          "additionalProperties": {
            "$ref": "#/$defs/field_format"
          },
          "description": "A declared shape for the kind's OWN optional fields, keyed by field name. A name the kind does not declare in optional_fields is refused at compile. A field with a shape that the reply does not carry is a format failure, not a skip: a kind that holds its payload in its own fields (register M13) could otherwise return none of them and be counted as having answered."
        }
      }
    },
    "field_format": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "all_of"
      ],
      "properties": {
        "all_of": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/check"
          }
        }
      }
    },
    "check": {
      "type": "object",
      "required": [
        "check"
      ],
      "properties": {
        "check": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        }
      }
    },
    "failure_policy": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "retries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16
        },
        "tolerance": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "numerator",
                "denominator"
              ],
              "properties": {
                "numerator": {
                  "type": "integer",
                  "minimum": 0
                },
                "denominator": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          ]
        },
        "action": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "skip_on_empty_port": {}
      }
    }
  }
}
