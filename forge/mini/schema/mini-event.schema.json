{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ahepi.example/mini/0.1/mini-event.schema.json",
  "title": "One append-only log event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_id",
    "body_ref",
    "commitments_ref",
    "cycle",
    "event_id",
    "kind_id",
    "payload",
    "prev",
    "schema_version",
    "seq",
    "stage_id",
    "type"
  ],
  "properties": {
    "schema_version": {
      "const": "creib.mini.event.v2"
    },
    "seq": {
      "type": "integer",
      "minimum": 0
    },
    "prev": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "type": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "stage_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 64
    },
    "kind_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 128
    },
    "artifact_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "body_ref": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "commitments_ref": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "payload": {
      "type": "object"
    },
    "event_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "cycle": {
      "type": "integer",
      "minimum": 0
    }
  }
}
