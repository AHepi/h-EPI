{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ahepi.example/mini/0.1/mini-policy.schema.json",
  "title": "One permission and authorisation document",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "policy_id", "defaults"],
  "properties": {
    "schema_version": {"const": "creib.mini.policy.v1"},
    "policy_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "required": ["read", "write", "changes"],
      "properties": {
        "read": {"type": "string", "minLength": 1, "maxLength": 64},
        "write": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 64}, "maxItems": 16},
        "changes": {"type": "string", "minLength": 1, "maxLength": 64}
      }
    },
    "grants": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/grant"}}
  },
  "$defs": {
    "grant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind_id"],
      "properties": {
        "kind_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "may_read_port_types": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 64}, "maxItems": 32},
        "may_write": {
          "type": "array",
          "maxItems": 32,
          "items": {"$ref": "https://ahepi.example/mini/0.1/mini-manifest.schema.json#/$defs/destination"}
        }
      }
    }
  }
}
