inside the fence, a note between two copies, a sentence quoting the draft, an apology before the form, a trailing summary that repeats a field. Say what the rule, read as written, says the check's answer ought to do. Your kernel is one of conformance.kernel.recovery, conformance.kernel.recovered-from-prose, conformance.kernel.response-verdict, conformance.kernel.refusal-phrase. The commitments are a STRING whose content is JSON of the form {\"kernel\": \"<id>\", \"input\": \"<the input text>\", \"rewritten\": \"<your rewritten text>\", \"expect\": \"moves\" or \"unchanged\", \"rewrite\": \"<one sentence naming what you changed>\"}. The input and the rewritten text are instances written out in full, never descriptions. Do not repeat a pair shown among the earlier proposals.","kind_id":"mini.pair-proposal.reply.v1","optional_fields":[],"output_port":{"port_id":"out","produces_kind":"mini.pair-proposal.reply.v1"},"title":"Proposal: a reply as written"},{"commitment_call":"two","commitment_ports":[],"failure_policy":{"action":"stop","retries":1,"skip_on_empty_port":false,"tolerance":null},"format":{"commitments":{"all_of":[{"check":"json_schema","schema":{"properties":{"verdicts":{"items":{"properties":{"catalogued":{"type":"boolean"},"column":{"enum":["moves","unchanged",null]},"executed":{"type":"string"},"expected":{"type":"string"},"kernel":{"type":"string"},"predicted":{"enum":["moves","unchanged","?",null]},"proposal":{"type":"string"},"reading":{"type":"string"},"same_input":{"type":["boolean","null"]},"standing":{"enum":["candidate point","defect","rejected"]},"transform":{"type":"string"}},"required":["proposal","executed","catalogued","standing"],"type":"object"},"type":"array"}},"required":["verdicts"],"type":"object"}}]}},"input_ports":[{"params":{},"port_id":"executions","port_type":"pair_executions","window":"this_cycle"},{"params":{},"port_id":"criticisms","port_type":"criticisms","window":"this_cycle"},{"params":{},"port_id":"verdicts","port_type":"earli