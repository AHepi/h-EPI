{
  "schema_version": "creib.mini.manifest.v1",
  "manifest_id": "mini.experiment.r2.d-claimed-properties",
  "problem": "The checks under test are the conformance harness's own functions. Most seats are shown only their documented rules, not their code: how the harness recovers a JSON object from a reply, whether it had to recover it from prose, its response verdict, its refusal-phrase check, and its grounding matcher. The question: is there an input and a rewrite of it on which the rule, read as written, says one thing and the check, run by machine, does another? The executor runs the check on both texts and records what its answer did; nothing here decides anything, the record shows where a reading and the machine parted.",
  "cycles": {
    "max_cycles": 3
  },
  "port_types": [
    {
      "port_type": "kernel_rules",
      "draws_from": {
        "artifact_kinds": [
          "mini.kernel-rules.v1"
        ]
      },
      "render": {
        "rule": "list_bodies",
        "header": "The documented rules of the checks"
      }
    },
    {
      "port_type": "kernel_source",
      "draws_from": {
        "artifact_kinds": [
          "mini.kernel-source.v1"
        ]
      },
      "render": {
        "rule": "list_bodies",
        "header": "The source of the checks"
      }
    },
    {
      "port_type": "pair_proposals",
      "draws_from": {
        "artifact_kinds": [
          "mini.pair-proposal.refute.v1"
        ]
      },
      "render": {
        "rule": "list_bodies_and_commitments",
        "header": "Proposals so far"
      }
    },
    {
      "port_type": "pair_executions",
      "draws_from": {
        "artifact_kinds": [
          "mini.pair-execution.v1"
        ]
      },
      "render": {
        "rule": "list_bodies_and_commitments",
        "header": "Executions"
      }
    },
    {
      "port_type": "criticisms",
      "draws_from": {
        "artifact_kinds": [
          "mini.criticism.v1"
        ]
      },
      "render": {
        "rule": "list_bodies",
        "header": "Criticisms"
      }
    },
    {
      "port_type": "earlier_verdicts",
      "draws_from": {
        "artifact_kinds": [
          "mini.verdict.v1"
        ]
      },
      "render": {
        "rule": "list_bodies_and_commitments",
        "header": "Verdicts so far"
      }
    },
    {
      "port_type": "one_mini.pair-proposal.refute.v1",
      "draws_from": {
        "artifact_kinds": [
          "mini.pair-proposal.refute.v1"
        ]
      },
      "render": {
        "rule": "list_bodies_and_commitments",
        "header": "The proposal"
      }
    },
    {
      "port_type": "properties",
      "draws_from": {
        "artifact_kinds": [
          "mini.property.v1"
        ]
      },
      "render": {
        "rule": "list_bodies_and_commitments",
        "header": "Claimed properties of the code"
      }
    }
  ],
  "kinds": [
    {
      "kind_id": "mini.kernel-rules.v1",
      "title": "Rules",
      "input_ports": [],
      "output_port": {
        "port_id": "out",
        "produces_kind": "mini.kernel-rules.v1"
      }
    },
    {
      "kind_id": "mini.kernel-source.v1",
      "title": "Source",
      "input_ports": [],
      "output_port": {
        "port_id": "out",
        "produces_kind": "mini.kernel-source.v1"
      }
    },
    {
      "kind_id": "mini.property.v1",
      "title": "Claimed properties",
      "input_ports": [
        {
          "port_id": "problem",
          "port_type": "problem",
          "window": "all"
        },
        {
          "port_id": "rules",
          "port_type": "kernel_rules",
          "window": "this_cycle"
        },
        {
          "port_id": "source",
          "port_type": "kernel_source",
          "window": "this_cycle"
        },
        {
          "port_id": "earlier",
          "port_type": "properties",
          "window": "all"
        },
        {
          "port_id": "verdicts",
          "port_type": "earlier_verdicts",
          "window": "all"
        }
      ],
      "output_port": {
        "port_id": "out",
        "produces_kind": "mini.property.v1"
      },
      "instruction": "Do not propose a test. You are shown the source of the checks. State THREE properties the code has that its documented rules do not state, or state differently: each an invariance ('the answer does not change when ...') or a sensitivity ('the answer changes when ...') of one kernel, precise enough that one input and one rewrite could refute it. Prefer properties that follow from how the code is written rather than from what it is for. The commitments are a STRING whose content is JSON of the form {\"properties\": [{\"kernel\": \"<id>\", \"claim\": \"<the property in one sentence>\", \"holds\": \"moves\" or \"unchanged\"}, ...]} with exactly three entries, where holds says what the answer does under the rewrite the claim names. Do not repeat a property shown among the earlier ones.",
      "format": {
        "commitments": {
          "all_of": [
            {
              "check": "json_schema",
              "schema": {
                "type": "object",
                "required": [
                  "properties"
                ],
                "properties": {
                  "properties": {
                    "type": "array",
                    "minItems": 3,
                    "maxItems": 3,
                    "items": {
                      "type": "object",
                      "required": [
                        "kernel",
                        "claim",
                        "holds"
                      ],
                      "properties": {
                        "kernel": {
                          "type": "string",
                          "pattern": "^conformance\\.kernel\\.[a-z-]+$"
                        },
                        "claim": {
                          "type": "string",
                          "minLength": 10
                        },
                        "holds": {
                          "enum": [
                            "moves",
                            "unchanged"
                          ]
                        }
                      }
                    }
                  }
                }
              }
            }
          ]
        }
      },
      "commitment_call": "single"
    },
    {
      "kind_id": "mini.pair-proposal.refute.v1",
      "title": "Proposal: refute a claimed property",
      "input_ports": [
        {
          "port_id": "problem",
          "port_type": "problem",
          "window": "all"
        },
        {
          "port_id": "rules",
          "port_type": "kernel_rules",
          "window": "this_cycle"
        },
        {
          "port_id": "properties",
          "port_type": "properties",
          "window": "this_cycle"
        },
        {
          "port_id": "earlier",
          "port_type": "pair_proposals",
          "window": "this_cycle"
        },
        {
          "port_id": "verdicts",
          "port_type": "earlier_verdicts",
          "window": "all"
        },
        {
          "port_id": "catalogue",
          "port_type": "evidence_legend",
          "window": "all",
          "params": {
            "tiers": [
              "evidence"
            ]
          }
        }
      ],
      "output_port": {
        "port_id": "out",
        "produces_kind": "mini.pair-proposal.refute.v1"
      },
      "instruction": "You are shown the documented rules of the checks and three properties someone claimed the code has after reading it. Do not read the code. Pick the claimed property this cycle's earlier proposals have not tested, and write ONE pair that would refute it if it is false: an input and a rewrite of the kind the claim names, and set expect to what the CLAIM says the answer does. If the machine disagrees with the claim, the claim was wrong; if it agrees, the claim survived one attempt. The commitments are a STRING whose content is JSON of the form {\"kernel\": \"<id>\", \"input\": \"<the input text>\", \"rewritten\": \"<your rewritten text>\", \"expect\": \"moves\" or \"unchanged\", \"rewrite\": \"<one sentence naming what you changed>\"}. The input and the rewritten text are instances written out in full, never descriptions. Do not repeat a pair shown among the earlier proposals. For the grounding kernels the input is one JSON object with the fields value, span and document, written out as a string; a line break inside a field is written as \\n. The commitments also carry \"claim\": \"<the claim you are testing, verbatim>\".",
      "format": {
        "commitments": {
          "all_of": [
            {
              "check": "json_schema",
              "schema": {
                "type": "object",
                "required": [
                  "kernel",
                  "input",
                  "rewritten",
                  "expect",
                  "rewrite",
                  "claim"
                ],
                "properties": {
                  "kernel": {
                    "type": "string",
                    "pattern": "^conformance\\.kernel\\.[a-z-]+$"
                  },
                  "input": {
                    "type": "string",
                    "minLength": 1
                  },
                  "rewritten": {
                    "type": "string",
                    "minLength": 1
                  },
                  "expect": {
                    "enum": [
                      "moves",
                      "unchanged"
                    ]
                  },
                  "rewrite": {
                    "type": "string",
                    "minLength": 3
                  },
                  "claim": {
                    "type": "string",
                    "minLength": 10
                  }
                }
              }
            }
          ]
        }
      },
      "commitment_call": "single"
    },
    {
      "kind_id": "mini.pair-execution.v1",
      "title": "Execution",
      "input_ports": [
        {
          "port_id": "proposals",
          "port_type": "pair_proposals",
          "window": "this_cycle"
        }
      ],
      "output_port": {
        "port_id": "out",
        "produces_kind": "mini.pair-execution.v1"
      }
    },
    {
      "kind_id": "mini.criticism.v1",
      "title": "Criticism",
      "input_ports": [
        {
          "port_id": "problem",
          "port_type": "problem",
          "window": "all"
        },
        {
          "port_id": "rules",
          "port_type": "kernel_rules",
          "window": "this_cycle"
        },
        {
          "port_id": "source",
          "port_type": "kernel_source",
          "window": "this_cycle"
        },
        {
          "port_id": "proposals",
          "port_type": "pair_proposals",
          "window": "this_cycle"
        },
        {
          "port_id": "executions",
          "port_type": "pair_executions",
          "window": "this_cycle"
        },
        {
          "port_id": "catalogue",
          "port_type": "evidence_legend",
          "window": "all",
          "params": {
            "tiers": [
              "evidence"
            ]
          }
        },
        {
          "port_id": "properties",
          "port_type": "properties",
          "window": "this_cycle"
        }
      ],
      "output_port": {
        "port_id": "out",
        "produces_kind": "mini.criticism.v1"
      },
      "instruction": "Do not propose. You are shown both the documented rules and the source. Read this cycle's executions beside the proposals: for each expectation that failed, say whether the proposer misread the rule, or the rule as written and the code part company; quote the rule's words and name the line of code. Say which failures matter and what a proposer should try next. Cite blocks by id. Each proposal tests a claimed property; say whether the property stands or fell, and whether a fallen property was a misreading of the code or a place where the code does what nobody wrote down."
    },
    {
      "kind_id": "mini.verdict.v1",
      "title": "Verdict",
      "input_ports": [
        {
          "port_id": "executions",
          "port_type": "pair_executions",
          "window": "this_cycle"
        },
        {
          "port_id": "criticisms",
          "port_type": "criticisms",
          "window": "this_cycle"
        },
        {
          "port_id": "verdicts",
          "port_type": "earlier_verdicts",
          "window": "all"
        },
        {
          "port_id": "catalogue",
          "port_type": "evidence_legend",
          "window": "all",
          "params": {
            "tiers": [
              "evidence"
            ]
          }
        }
      ],
      "output_port": {
        "port_id": "out",
        "produces_kind": "mini.verdict.v1"
      },
      "format": {
        "commitments": {
          "all_of": [
            {
              "check": "json_schema",
              "schema": {
                "type": "object",
                "required": [
                  "verdicts"
                ],
                "properties": {
                  "verdicts": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "proposal",
                        "executed",
                        "catalogued",
                        "standing"
                      ],
                      "properties": {
                        "proposal": {
                          "type": "string"
                        },
                        "kernel": {
                          "type": "string"
                        },
                        "transform": {
                          "type": "string"
                        },
                        "executed": {
                          "type": "string"
                        },
                        "expected": {
                          "type": "string"
                        },
                        "catalogued": {
                          "type": "boolean"
                        },
                        "same_input": {
                          "type": [
                            "boolean",
                            "null"
                          ]
                        },
                        "standing": {
                          "enum": [
                            "candidate point",
                            "defect",
                            "rejected"
                          ]
                        },
                        "column": {
                          "enum": [
                            "moves",
                            "unchanged",
                            null
                          ]
                        },
                        "predicted": {
                          "enum": [
                            "moves",
                            "unchanged",
                            "?",
                            null
                          ]
                        },
                        "reading": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          ]
        }
      }
    }
  ],
