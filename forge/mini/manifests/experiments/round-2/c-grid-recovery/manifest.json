            ]
          }
        }
      ],
      "output_port": {
        "port_id": "out",
        "produces_kind": "mini.verdict.v1"
      },
      "format": {
        "commitments": {
          "all_of": [
            {
              "check": "json_schema",
              "schema": {
                "type": "object",
                "required": [
                  "verdicts"
                ],
                "properties": {
                  "verdicts": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "proposal",
                        "executed",
                        "catalogued",
                        "standing"
                      ],
                      "properties": {
                        "proposal": {
                          "type": "string"
                        },
                        "kernel": {
                          "type": "string"
                        },
                        "transform": {
                          "type": "string"
                        },
                        "executed": {
                          "type": "string"
                        },
                        "expected": {
                          "type": "string"
                        },
                        "catalogued": {
                          "type": "boolean"
                        },
                        "same_input": {
