        },
        {
          "port_id": "proposals",
          "port_type": "pair_proposals",
          "window": "this_cycle"
        },
        {
          "port_id": "executions",
          "port_type": "pair_executions",
          "window": "this_cycle"
        },
        {
          "port_id": "catalogue",
          "port_type": "evidence_legend",
          "window": "all",
          "params": {
