      "output_port": {
        "port_id": "out",
        "produces_kind": "mini.pair-proposal.grid-1.v1"
      },
      "instruction": "You are shown the documented rules of the recovery check, not its code, and ONE cell of a grid of reply shapes under 'The cell to cover'. The cell is written in a notation: fence[ ... ] is a code fence, a line of three backticks before and after, holding one part per line in the order given; S is one plain sentence such as 'Here is the result:'; A, B and C are small JSON objects different from each other, such as {\"a\": 1}, {\"b\": 2}, {\"c\": 3}; anything after the closing ] comes after the closing fence line, one part per line. Build the input exactly from the cell, parts on their own lines, nothing added. The rewritten text is the same reply with ONE part removed, and say what the rule says the recovered object ought to do: move or stay. Your expectation comes from the rule's words alone: name in the body which object the rule says is scored before and after. The commitments carry \"cell\": the cell exactly as named. The commitments are a STRING whose content is JSON of the form {\"kernel\": \"<id>\", \"input\": \"<the input text>\", \"rewritten\": \"<your rewritten text>\", \"expect\": \"moves\" or \"unchanged\", \"rewrite\": \"<one sentence naming what you changed>\", \"cell\": \"<the cell exactly as named>\"}. The input and the rewritten text are instances written out in full, never descriptions. Do not repeat a pair shown among the earlier proposals.",
      "format": {
        "commitments": {
          "all_of": [
            {
              "check": "json_schema",
              "schema": {
                "type": "object",
                "required": [
                  "kernel",
                  "input",
                  "rewritten",
                  "expect",
                  "rewrite",
                  "cell"
                ],
                "properties": {
                  "kernel": {
                    "type": "string",
                    "pattern": "^conformance\\.kernel\\.(recovery|recovered-from-prose|response-verdict)$"
                  },
                  "input": {
                    "type": "string",
                    "minLength": 1
                  },
                  "rewritten": {
                    "type": "string",
                    "minLength": 1
                  },
                  "expect": {
                    "enum": [
                      "moves",
                      "unchanged"
                    ]
                  },
                  "rewrite": {
                    "type": "string",
                    "minLength": 3
                  },
                  "cell": {
                    "type": "string",
                    "minLength": 3
                  }
                }
              }
            }
          ]
        }
      },
      "commitment_call": "single"
    },
