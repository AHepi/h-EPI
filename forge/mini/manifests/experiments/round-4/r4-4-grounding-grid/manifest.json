                          "enum": [
                            "moves",
                            "unchanged",
                            null
                          ]
                        },
                        "predicted": {
                          "enum": [
                            "moves",
                            "unchanged",
                            "?",
                            null
                          ]
                        },
                        "reading": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
