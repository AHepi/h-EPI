                        "executed",
                        "catalogued",
                        "standing"
                      ],
                      "properties": {
                        "proposal": {
                          "type": "string"
                        },
                        "kernel": {
                          "type": "string"
                        },
                        "transform": {
                          "type": "string"
                        },
                        "executed": {
                          "type": "string"
                        },
                        "expected": {
                          "type": "string"
                        },
                        "catalogued": {
                          "type": "boolean"
                        },
                        "same_input": {
                          "type": [
                            "boolean",
                            "null"
                          ]
                        },
                        "standing": {
                          "enum": [
                            "candidate point",
                            "defect",
                            "rejected"
                          ]
                        },
