      {
       "code": "// Mood is a hidden score: insult -2, apology +2, gift +1; warm when score >= 2.\nfunction visible(actions) {\n  let score = 0;\n  for (const action of actions) {\n    if (action === \"insult\") score -= 2;\n    else if (action === \"apologise\") score += 2;\n    else if (action === \"gift\") score += 1;\n  }\n  return { mood: score >= 2 ? \"warm\" : \"cold\" };\n}",
       "comment": "Mood is a hidden score: insult -2, apology +2, gift +1; warm when score >= 2.",
       "problem": null,
       "fits": true,
       "true_everywhere": false
      },
      {
       "code": "// Robin tracks insults since last apology; apology warms only if debt <= 1, gift only if debt is 0.\nfunction visible(actions) {\n  let insultsSinceApology = 0;\n  let mood = \"cold\";\n  for (const action of actions) {\n    if (action === \"insult\") {\n      insultsSinceApology += 1;\n      mood = \"cold\";\n    } else if (action === \"apologise\") {\n      mood = insultsSinceApology <= 1 ? \"warm\" : \"cold\";\n      insultsSinceApology = 0;\n    } else if (action === \"gift\") {\n      mood = insultsSinceApology === 0 ? \"warm\" : \"cold\";\n    }\n  }\n  return { mood };\n}",
       "comment": "Robin tracks insults since last apology; apology warms only if debt <= 1, gift only if debt is 0.",
       "problem": null,
       "fits": true,
       "true_everywhere": false
      },
      {
       "code": "// Robin tracks hidden anger and trust; apology cuts anger and adds trust, gift cuts anger and adds trust only after apology; warm if trust > anger.\nfunction visible(actions) {\n  let anger = 0;\n  let trust = 0;\n  let prev = null;\n  for (const action of actions) {\n    if (action === \"insult\") {\n      anger += 2;\n    } else if (action === \"apologise\") {\n      anger = Math.max(0, anger - 2);\n      trust += 1;\n    } else if (action === \"gift\") {\n      anger = Math.max(0, anger - 1);\n      if (prev === \"apologise\") trust += 1;\n    }\n    prev = action;\n  }\n  return { mood: trust > anger ? \"warm\" : \"cold\" };\n}",
       "comment": "Robin tracks hidden anger and trust; apology cuts anger and adds trust, gift cuts anger and adds trust only after apology; warm if trust > anger.",
       "problem": null,
       "fits": true,
       "true_everywhere": false
      },
