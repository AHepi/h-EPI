     "code": "function visible(actions) {\n  const tube = [];\n  let error = false;\n\n  for (const action of actions) {\n    if (action === \"red in\") {\n      tube.push(\"red\");\n    } else if (action === \"blue in\") {\n      tube.push(\"blue\");\n    } else if (action === \"red out\") {\n      if (tube.length > 0 && tube[tube.length - 1] === \"red\") {\n        tube.pop();\n      } else {\n        error = true;\n      }\n    } else if (action === \"blue out\") {\n      if (tube.length > 0 && tube[tube.length - 1] === \"blue\") {\n        tube.pop();\n      } else {\n        error = true;\n      }\n    }\n  }\n\n  if (error) return { light: \"red\" };\n  if (tube.length === 0) return { light: \"green\" };\n  return { light: \"amber\" };\n}"
    }
