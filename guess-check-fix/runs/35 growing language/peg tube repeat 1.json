     "code": "function visible(actions) {\n  const stack = [];\n  let invalid = false;\n\n  for (const action of actions) {\n    if (action === \"red in\") {\n      stack.push(\"red\");\n    } else if (action === \"blue in\") {\n      stack.push(\"blue\");\n    } else if (action === \"red out\") {\n      if (stack.length === 0 || stack[stack.length - 1] !== \"red\") {\n        invalid = true;\n      } else {\n        stack.pop();\n      }\n    } else if (action === \"blue out\") {\n      if (stack.length === 0 || stack[stack.length - 1] !== \"blue\") {\n        invalid = true;\n      } else {\n        stack.pop();\n      }\n    }\n  }\n\n  if (invalid) {\n    return { light: \"red\" };\n  }\n\n  return { light: stack.length === 0 ? \"green\" : \"amber\" };\n}"
    }
