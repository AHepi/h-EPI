     "code": "function visible(actions) {\n  const stack = [];\n  let error = false;\n\n  for (const action of actions) {\n    if (action === \"red in\") {\n      stack.push(\"red\");\n    } else if (action === \"blue in\") {\n      stack.push(\"blue\");\n    } else if (action === \"red out\") {\n      if (stack.length > 0 && stack[stack.length - 1] === \"red\") {\n        stack.pop();\n      } else {\n        error = true;\n      }\n    } else if (action === \"blue out\") {\n      if (stack.length > 0 && stack[stack.length - 1] === \"blue\") {\n        stack.pop();\n      } else {\n        error = true;\n      }\n    }\n  }\n\n  let light;\n  if (error) {\n    light = \"red\";\n  } else if (stack.length === 0) {\n    light = \"green\";\n  } else {\n    light = \"amber\";\n  }\n\n  return { light };\n}"
    }
